# ──────────────────────────────────────────────────────────────
# Mivio Web — Environment Variables
# Copy this file to .env (or set these in the Vercel dashboard)
# ──────────────────────────────────────────────────────────────

# Brevo (formerly Sendinblue) API key
# Get it at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Brevo list IDs for each waitlist segment
# Find list IDs at: https://app.brevo.com/contact/list
BREVO_LIST_NEWSLETTER=127    # General newsletter (product updates)
BREVO_LIST_APPS=123          # Mivio Apps waitlist (all platforms)
BREVO_LIST_CLOUD=124         # Mivio Cloud Space waitlist
BREVO_LIST_B2B=125           # Mivio B2B / White-label waitlist
BREVO_LIST_MARKETPLACE=126   # Mivio VR Marketplace waitlist

# Microsoft Clarity project ID (public, ships to the browser — not a secret)
# Leave unset to disable Clarity (e.g. local dev)
# Find it at: https://clarity.microsoft.com/projects
PUBLIC_CLARITY_ID=your_clarity_project_id_here