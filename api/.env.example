# ──────────────────────────────────────────────────────────────
# Mivio Web — Environment Variables
# Copy this file to .env (or set these in the Vercel dashboard)
# ──────────────────────────────────────────────────────────────

# Brevo (formerly Sendinblue) API key
# Get it at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Brevo list IDs for each waitlist segment
# Find list IDs at: https://app.brevo.com/contact/list
BREVO_LIST_APPS=123          # Mivio Apps (all platforms)
BREVO_LIST_CLOUD=124         # Mivio Cloud Space
BREVO_LIST_B2B=125           # Mivio B2B / White-label
BREVO_LIST_MARKETPLACE=126   # Mivio VR Marketplace
