---
export interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="min-w-0">
  <div class="text-base sm:text-3xl font-extrabold gradient-text truncate">{value}</div>
  <div class="text-fg-faint text-[9px] sm:text-xs mt-1 uppercase tracking-tight sm:tracking-widest truncate">{label}</div>
</div>
