---
import CheckListItem from './CheckListItem.astro';

export interface Props {
  plan: string;
  price: string;
  period: string;
  billedNote?: string;
  savingsBadge?: string;
  trialBadge?: string;
  popular?: boolean;
  ctaText?: string;
  features?: string[];
  featuresIntro?: string;
  waitlistSegment: string;
}

const {
  plan,
  price,
  period,
  billedNote,
  savingsBadge,
  trialBadge,
  popular = false,
  ctaText = 'Get early access',
  features,
  featuresIntro,
  waitlistSegment,
} = Astro.props;

const cardClass = popular
  ? 'card rounded-3xl p-7 flex flex-col justify-between gap-6 border-primary relative overflow-hidden ring-1 ring-primary/40 shadow-2xl shadow-primary/10 bg-gradient-to-b from-primary/[0.04] to-transparent'
  : 'card rounded-3xl p-7 flex flex-col justify-between gap-6 hover:border-primary/40 transition-all duration-300';
---

<div class={cardClass}>
  {popular && (
    <div class="absolute top-0 right-0 bg-primary text-white text-[11px] font-extrabold tracking-wider uppercase px-4 py-1 rounded-bl-xl shadow-sm">
      {savingsBadge || 'Most Popular'}
    </div>
  )}

  <div>
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="text-xs font-bold uppercase tracking-widest text-primary">{plan}</span>
      {!popular && savingsBadge && (
        <span class="text-[11px] font-bold text-fg-subtle bg-surface-alt border border-subtle px-2.5 py-0.5 rounded-full">
          {savingsBadge}
        </span>
      )}
    </div>

    <div class="mt-2">
      <div class="flex items-baseline gap-1.5">
        <span class="text-4xl sm:text-5xl font-extrabold text-fg tracking-tight">{price}</span>
        <span class="text-sm font-semibold text-fg-subtle">{period}</span>
      </div>
      {billedNote && (
        <p class="text-xs text-fg-faint mt-1.5">{billedNote}</p>
      )}
    </div>

    {trialBadge && (
      <div class="mt-3.5 inline-flex items-center gap-1.5 text-xs font-semibold text-primary bg-primary/10 border border-primary/20 px-3 py-1 rounded-full">
        <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>{trialBadge}</span>
      </div>
    )}
  </div>

  {features && features.length > 0 && (
    <>
      <div class="h-px bg-subtle w-full"></div>
      <div class="flex flex-col gap-3 flex-grow">
        {featuresIntro && (
          <p class="text-xs font-bold uppercase tracking-wider text-fg-faint">{featuresIntro}</p>
        )}
        <ul class="flex flex-col gap-2.5 text-sm text-fg-subtle">
          {features.map((feature) => (
            <CheckListItem>{feature}</CheckListItem>
          ))}
        </ul>
      </div>
    </>
  )}

  <button
    type="button"
    data-waitlist={waitlistSegment}
    class={popular
      ? 'btn-primary text-white text-center font-bold py-3 px-4 rounded-2xl text-sm w-full shadow-lg shadow-primary/20'
      : 'btn-outline text-fg text-center font-semibold py-3 px-4 rounded-2xl text-sm w-full hover:border-primary/50'}
  >
    {ctaText}
  </button>
</div>
