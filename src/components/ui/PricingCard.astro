---
import CheckListItem from './CheckListItem.astro';

export interface Props {
  plan: string;
  price: string;
  period: string;
  billedNote?: string;
  savingsBadge?: string;
  trialBadge?: string;
  popular?: boolean;
  ctaText?: string;
  features?: string[];
  featuresIntro?: string;
  waitlistSegment: string;
}

const {
  plan,
  price,
  period,
  billedNote,
  savingsBadge,
  trialBadge,
  popular = false,
  ctaText = 'Get early access',
  features,
  featuresIntro,
  waitlistSegment,
} = Astro.props;

const cardClass = popular
  ? 'card rounded-3xl p-7 flex flex-col justify-between gap-6 border-primary relative overflow-hidden ring-1 ring-primary/40 shadow-2xl shadow-primary/10 bg-gradient-to-b from-primary/[0.04] to-transparent'
  : 'card rounded-3xl p-7 flex flex-col justify-between gap-6 hover:border-primary/40 transition-all duration-300';
---

<div class="flex flex-col relative transition-transform hover:-translate-y-1 h-full" style="background:rgba(224,112,79,.15);border:1px solid rgba(242,236,223,.14);border-radius:16px;padding:14px 14px 12px;box-shadow:0 24px 60px rgba(0,0,0,.42),inset 0 1px 0 rgba(242,236,223,.10)">
  <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:2px 4px 12px"></div>
  <div class="flex flex-col justify-between gap-6 relative flex-1" style="background:rgba(255,255,255,.58);backdrop-filter:blur(22px) brightness(3.1) saturate(.72);-webkit-backdrop-filter:blur(22px) brightness(3.1) saturate(.72);border:1px solid rgba(255,255,255,.42);border-radius:12px;padding:24px;color:#241d15;">
    
    {popular && (
      <div class="absolute top-0 right-0 bg-primary text-white text-[11px] font-extrabold tracking-wider uppercase px-4 py-1 rounded-bl-xl rounded-tr-xl shadow-sm">
        {savingsBadge || 'Most Popular'}
      </div>
    )}

    <div>
      <div class="flex items-center justify-between gap-2 mb-2">
        <span class="text-xs font-bold uppercase tracking-widest text-primary">{plan}</span>
        {!popular && savingsBadge && (
          <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full" style="background:rgba(255,255,255,.5);border:1px solid rgba(36,29,21,.15);color:rgba(36,29,21,.7);">
            {savingsBadge}
          </span>
        )}
      </div>

      <div class="mt-2">
        <div class="flex items-baseline gap-1.5">
          <span class="text-4xl sm:text-5xl font-extrabold tracking-tight" style="color:#241d15;">{price}</span>
          <span class="text-sm font-semibold" style="color:rgba(36, 29, 21, 0.8);">{period}</span>
        </div>
        {billedNote && (
          <p class="text-xs mt-1.5" style="color:rgba(36, 29, 21, 0.6);">{billedNote}</p>
        )}
      </div>

      {trialBadge && (
        <div class="mt-3.5 inline-flex items-center gap-1.5 text-xs font-semibold text-primary bg-primary/10 border border-primary/20 px-3 py-1 rounded-full">
          <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{trialBadge}</span>
        </div>
      )}
    </div>

    {features && features.length > 0 && (
      <>
        <div class="h-px w-full" style="background:rgba(36,29,21,.1);"></div>
        <div class="flex flex-col gap-3 flex-grow">
          {featuresIntro && (
            <p class="text-xs font-bold uppercase tracking-wider" style="color:rgba(36, 29, 21, 0.5);">{featuresIntro}</p>
          )}
          <ul class="flex flex-col gap-2.5 text-sm" style="color:rgba(36, 29, 21, 0.8);">
            {features.map((feature) => (
              <CheckListItem>{feature}</CheckListItem>
            ))}
          </ul>
        </div>
      </>
    )}

    <button
      type="button"
      data-waitlist={waitlistSegment}
      class={popular
        ? 'btn-primary text-white text-center font-bold py-3 px-4 rounded-2xl text-sm w-full shadow-lg shadow-primary/20'
        : 'text-center font-semibold py-3 px-4 rounded-2xl text-sm w-full hover:bg-black/5 transition-colors border'}
      style={popular ? '' : 'border-color:rgba(36,29,21,.15); color:#241d15;'}
    >
      {ctaText}
    </button>
  </div>
  <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:12px 4px 2px"></div>
</div>
