---
import CheckListItem from './CheckListItem.astro';

export interface Props {
  plan: string;
  monthlyFirst: string;
  monthlyThen: string;
  annualPrice: string;
  annualBilled: string;
  features: string[];
  featuresIntro?: string;
  popular?: boolean;
  waitlistSegment: string;
}

const { plan, monthlyFirst, monthlyThen, annualPrice, annualBilled, features, featuresIntro, popular = false, waitlistSegment } = Astro.props;
const cardClass = popular
  ? 'card rounded-3xl p-6 flex flex-col gap-5 border-primary/40 relative overflow-hidden'
  : 'card rounded-3xl p-6 flex flex-col gap-5 hover:border-primary/30 transition-colors';
---

<div class={cardClass}>
  {popular && (
    <div class="absolute top-0 right-0 bg-primary text-white text-xs font-bold px-4 py-1 rounded-bl-xl">
      Most Popular
    </div>
  )}
  <div>
    <span class="text-xs font-semibold uppercase tracking-widest text-fg-faint">{plan}</span>
    <div class="mt-3">
      <div class="billing-monthly">
        <div class="text-4xl font-extrabold text-fg">{monthlyFirst}</div>
        <div class="text-xs text-fg-faint mt-1">1st month, then <span class="text-fg-subtle font-semibold">{monthlyThen}</span></div>
      </div>
      <div class="billing-annual hidden">
        <div class="text-4xl font-extrabold text-fg">{annualPrice}<span class="text-lg font-normal text-fg-subtle">/mo</span></div>
        <div class="text-xs text-fg-faint mt-1">Billed <span class="text-fg-subtle font-semibold">{annualBilled}</span></div>
      </div>
    </div>
  </div>

  <ul class="flex flex-col gap-2 text-sm text-fg-subtle flex-grow">
    {featuresIntro && <li class="text-xs font-semibold text-fg-faint uppercase tracking-wide mb-1">{featuresIntro}</li>}
    {features.map((feature) => <CheckListItem>{feature}</CheckListItem>)}
  </ul>

  <button type="button" data-waitlist={waitlistSegment} class="btn-primary text-white text-center font-semibold py-2.5 rounded-xl text-sm mt-auto w-full">
    Get early access
  </button>
</div>
