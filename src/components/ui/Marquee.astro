---
export interface Props {
  items?: string[];
  separator?: string;
  speed?: string;
  class?: string;
}

const {
  items = [],
  separator = '✦',
  speed = '25s',
  class: className = '',
} = Astro.props;
---

<div class={`w-full max-w-5xl mx-auto overflow-hidden py-3.5 border-y border-subtle select-none marquee-mask ${className}`}>
  <div
    class="flex whitespace-nowrap w-max animate-marquee hover:[animation-play-state:paused] font-mono text-xs tracking-[0.24em] text-fg-subtle"
    style={`--marquee-speed: ${speed};`}
  >
    <div class="flex items-center gap-8 pr-8">
      {items.map((item) => (
        <span class="inline-flex items-center gap-8">
          <span class="font-medium text-fg">{item}</span>
          <span class="text-primary text-sm leading-none select-none">{separator}</span>
        </span>
      ))}
      <slot />
    </div>
    <div class="flex items-center gap-8 pr-8" aria-hidden="true">
      {items.map((item) => (
        <span class="inline-flex items-center gap-8">
          <span class="font-medium text-fg">{item}</span>
          <span class="text-primary text-sm leading-none select-none">{separator}</span>
        </span>
      ))}
      <slot />
    </div>
  </div>
</div>

<style>
  .marquee-mask {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee-scroll var(--marquee-speed, 25s) linear infinite;
  }
</style>
