---
import CheckListItem from './CheckListItem.astro';

export interface Props {
  title: string;
  description: string;
  features: string[];
  waitlistSegment: string;
  sourceUrl: string;
  releaseUrl: string;
  releaseLabel: string;
}

const { title, description, features, waitlistSegment, sourceUrl, releaseUrl, releaseLabel } = Astro.props;
---

<div class="flex flex-col relative transition-transform hover:-translate-y-1" style="background:rgba(224,112,79,.15);border:1px solid rgba(242,236,223,.14);border-radius:16px;padding:14px 14px 12px;box-shadow:0 24px 60px rgba(0,0,0,.42),inset 0 1px 0 rgba(242,236,223,.10)">
  <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:2px 4px 12px"></div>
  <div class="flex flex-col flex-1 relative" style="background:rgba(255,255,255,.58);backdrop-filter:blur(22px) brightness(3.1) saturate(.72);-webkit-backdrop-filter:blur(22px) brightness(3.1) saturate(.72);border:1px solid rgba(255,255,255,.42);border-radius:12px;padding:24px;color:#241d15;">
    <div class="absolute top-4 right-4 bg-primary/10 border border-primary/20 text-primary text-xs font-bold px-2.5 py-1 rounded-full">
      Coming Soon
    </div>
    <div class="w-12 h-12 bg-primary/10 rounded-2xl flex items-center justify-center mb-6 border border-primary/20 text-primary">
      <slot name="icon" />
    </div>
    <h2 class="text-2xl font-bold mb-2">{title}</h2>
    <p class="text-sm" style="color:rgba(36, 29, 21, 0.8);">{description}</p>
    <ul class="text-sm mb-6 flex-grow flex flex-col gap-2 mt-4" style="color:rgba(36, 29, 21, 0.8);">
      {features.map((feature) => <CheckListItem>{feature}</CheckListItem>)}
    </ul>
    <div class="flex flex-col gap-3 mt-auto">
      <button type="button" data-waitlist={waitlistSegment} class="w-full py-2.5 px-4 btn-primary text-white font-semibold rounded-xl text-center flex items-center justify-center gap-2">Join the waitlist</button>
      <div class="flex items-center justify-center gap-2 mt-2 flex-nowrap border-t border-subtle pt-4">
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-full border whitespace-nowrap flex items-center justify-center gap-2 text-xs font-semibold hover:bg-black/5 transition-colors" style="background:rgba(255,255,255,.5);border-color:rgba(36,29,21,.15);color:rgba(36,29,21,.7);">
          <svg aria-hidden="true" class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg> <span>Source Code</span>
        </a>
        <a href={releaseUrl} target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-full border whitespace-nowrap flex items-center justify-center gap-2 text-xs font-semibold hover:bg-black/5 transition-colors" style="background:rgba(255,255,255,.5);border-color:rgba(36,29,21,.15);color:rgba(36,29,21,.7);">
          <svg aria-hidden="true" class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M21 16.5c0 .38-.21.71-.53.88l-7.9 4.44c-.16.12-.36.18-.57.18s-.41-.06-.57-.18l-7.9-4.44A.991.991 0 013 16.5v-9c0-.38.21-.71.53-.88l7.9-4.44c.16-.12.36-.18.57-.18s.41.06.57.18l7.9 4.44c.32.17.53.5.53.88v9zM12 4.15L6.04 7.5 12 10.85l5.96-3.35L12 4.15zM5 15.91l6 3.38v-6.71L5 9.19v6.72zm14 0v-6.72l-6 3.39v6.71l6-3.38z"/></svg> <span>{releaseLabel}</span>
        </a>
      </div>
    </div>
  </div>
  <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:12px 4px 2px"></div>
</div>
