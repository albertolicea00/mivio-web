---
export interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="card group rounded-3xl p-8 hover:border-primary/25 transition-all duration-300">
  <div class="w-14 h-14 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
    <slot name="icon" />
  </div>
  <span class="text-xs text-primary font-semibold uppercase tracking-widest">{eyebrow}</span>
  <h3 class="text-xl font-bold mt-2 mb-3 text-fg">{title}</h3>
  <p class="text-fg-subtle leading-relaxed text-sm">
    <slot />
  </p>
</div>
