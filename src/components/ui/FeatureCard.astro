---
export interface Props {
  eyebrow: string;
  title: string;
  tag?: string;
  class?: string;
}

const { eyebrow, title, tag, class: className = '' } = Astro.props;
---

<div class={`flex flex-col relative transition-transform hover:-translate-y-1 h-full group ${className}`} style="background:rgba(224,112,79,.15);border:1px solid rgba(242,236,223,.14);border-radius:16px;padding:14px 14px 12px;box-shadow:0 24px 60px rgba(0,0,0,.42),inset 0 1px 0 rgba(242,236,223,.10)">
  <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:2px 4px 12px"></div>
  <div class="flex flex-col justify-between relative flex-1" style="background:rgba(255,255,255,.58);backdrop-filter:blur(22px) brightness(3.1) saturate(.72);-webkit-backdrop-filter:blur(22px) brightness(3.1) saturate(.72);border:1px solid rgba(255,255,255,.42);border-radius:12px;padding:24px;color:#241d15;">
    <div>
      {tag && (
        <div class="flex items-center justify-between gap-2 mb-4 pb-2 border-b border-[rgba(36,29,21,0.08)]">
          <span class="text-[10.5px] font-mono font-bold tracking-widest uppercase text-[#78716c]">
            {tag}
          </span>
        </div>
      )}

      <!-- Icon + Title side-by-side -->
      <div class="flex items-center gap-3.5 mb-3.5">
        <div class="shrink-0 text-[#6b635b] flex items-center">
          <slot name="icon" />
        </div>
        <div class="flex flex-col min-w-0">
          {eyebrow && (
            <span class="text-xs font-bold uppercase tracking-wider text-[#78716c] leading-tight">
              {eyebrow}
            </span>
          )}
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[#241d15] leading-snug mt-0.5">
            {title}
          </h3>
        </div>
      </div>

      <p class="text-sm leading-relaxed" style="color:rgba(36, 29, 21, 0.78);">
        <slot />
      </p>
    </div>
  </div>
  <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:12px 4px 2px"></div>
</div>

<style>
  p :global(strong) {
    color: #241d15;
    font-weight: 700;
  }
</style>
