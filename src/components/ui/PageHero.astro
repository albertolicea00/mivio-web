---
export interface Props {
  size?: 'lg' | 'md';
  class?: string;
  descriptionClass?: string;
}

const {
  size = 'lg',
  class: className = 'mb-16 text-center',
  descriptionClass = 'text-fg-subtle text-lg max-w-2xl mx-auto',
} = Astro.props;

const titleClass = size === 'lg'
  ? 'font-extrabold text-4xl sm:text-5xl md:text-6xl mb-6 text-fg leading-tight'
  : 'text-4xl sm:text-5xl font-extrabold mb-4 text-fg';
---

<header class={className}>
  <h1 class={titleClass}><slot /></h1>
  <p class={descriptionClass}><slot name="description" /></p>
</header>
