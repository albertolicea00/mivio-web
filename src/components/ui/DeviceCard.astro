---
export interface Props {
  href: string;
  title: string;
  subtitle: string;
  class?: string;
}

const { href, title, subtitle, class: className = '' } = Astro.props;
---

<a
  href={href}
  class={`group card rounded-2xl sm:rounded-3xl p-4 sm:p-5 flex flex-col items-center text-center gap-3 hover:border-primary/40 transition-all duration-300 ${className}`}
>
  <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center group-hover:bg-primary/20 transition-colors text-primary shrink-0">
    <slot />
  </div>
  <div class="flex flex-col gap-0.5">
    <div class="font-bold text-sm sm:text-base text-fg">{title}</div>
    <div class="text-[11px] sm:text-xs text-fg-faint leading-snug">{subtitle}</div>
  </div>
</a>
