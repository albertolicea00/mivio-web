---
export interface Props {
  align?: 'center' | 'start';
}

const { align = 'center' } = Astro.props;
const alignClass = align === 'start' ? 'items-start' : 'items-center';
const iconClass = align === 'start' ? 'w-4 h-4 text-primary shrink-0 mt-0.5' : 'w-4 h-4 text-primary shrink-0';
---

<li class={`flex ${alignClass} gap-2`}>
  <svg aria-hidden="true" class={iconClass} fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
  <slot />
</li>
