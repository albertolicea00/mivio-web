---
// Footer.astro — Vanilla JS Footer
---

<footer class="footer-bar py-12 px-6 mt-12 border-t border-subtle bg-page">
  <div class="max-w-6xl mx-auto px-4 text-sm text-fg-faint">

    <!-- Top: brand + columns in one row on desktop -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-10">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-2 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <img src="/static/images/mivio-icon.webp" alt="Mivio" width="28" height="28" class="w-7 h-7 rounded-md" />
          <span class="text-fg font-bold text-lg">Mivio</span>
        </div>
        <p class="leading-relaxed text-xs">The ultimate multi-platform media experience. Bring your own media.</p>
      </div>

      <!-- Products -->
      <div class="flex flex-col gap-3">
        <h3 class="text-fg font-semibold mb-1">Products</h3>
        <a href="download.html" class="hover:text-fg transition-colors w-fit">Native Apps</a>
        <a href="pricing.html" class="hover:text-fg transition-colors w-fit">Pricing</a>
        <a href="cloud.html" class="hover:text-fg transition-colors w-fit">Cloud</a>
        <a href="b2b.html" class="hover:text-fg transition-colors w-fit">B2B</a>
        <a href="marketplace.html" class="hover:text-fg transition-colors w-fit">VR Marketplace</a>
      </div>

      <!-- Resources -->
      <div class="flex flex-col gap-3">
        <h3 class="text-fg font-semibold mb-1">Resources</h3>
        <a href="manual.html" class="hover:text-fg transition-colors w-fit">User Manual</a>
        <a href="marketplace.html" class="hover:text-fg transition-colors w-fit">Developer Docs</a>
        <a href="terms.html" class="hover:text-fg transition-colors w-fit">Terms</a>
        <a href="privacy.html" class="hover:text-fg transition-colors w-fit">Privacy</a>
      </div>

      <!-- Social -->
      <div class="col-span-2 sm:col-span-1 md:col-span-1 flex flex-col gap-3">
        <h3 class="text-fg font-semibold mb-1">Social</h3>
        <div class="grid grid-cols-2 sm:flex sm:flex-col gap-3">
          <a
            href="https://github.com/albertolicea00"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-fg transition-colors w-fit"
          >
            <svg aria-hidden="true" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
          </a>
          <a
            href="https://x.com/albertolicea00"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-fg transition-colors w-fit"
          >
            <svg aria-hidden="true" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>X (Twitter)</span>
          </a>
          <a
            href="https://linkedin.com/in/albertolicea00"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-fg transition-colors w-fit"
          >
            <svg aria-hidden="true" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
          <a
            href="https://instagram.com/albertolicea00"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-fg transition-colors w-fit"
          >
            <svg aria-hidden="true" class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Newsletter -->
    <div
      class="border-t border-subtle pt-6 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
    >
      <div class="shrink-0">
        <p class="text-fg font-semibold text-sm">Stay in the loop</p>
        <p class="text-xs text-fg-faint mt-0.5">Product updates and early access announcements.</p>
      </div>

      <form id="footer-newsletter-form" class="flex flex-col gap-1.5 sm:items-end">
        <div id="newsletter-input-wrap" class="flex gap-2">
          <input
            id="newsletter-email"
            type="email"
            placeholder="you@example.com"
            required
            autocomplete="email"
            class="rounded-xl border border-subtle bg-surface px-4 py-2 text-sm text-fg placeholder:text-fg-faint focus:outline-none focus:border-primary/50 transition-colors w-52"
          />
          <button
            type="submit"
            id="newsletter-submit-btn"
            class="btn-primary text-white font-semibold px-5 py-2 rounded-xl text-sm disabled:opacity-60 whitespace-nowrap shrink-0"
          >
            <span id="newsletter-btn-text">Subscribe</span>
          </button>
        </div>
        <p id="newsletter-error" class="hidden text-xs text-red-400"></p>
        <p id="newsletter-success" class="hidden text-xs text-primary font-semibold">You're subscribed!</p>
      </form>
    </div>

    <!-- Bottom: copyright & credits -->
    <div class="border-t border-subtle pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-fg-faint">
        &copy; {new Date().getFullYear()} Mivio. All rights reserved.
      </p>
      <p class="flex items-center gap-1 text-xs">
        Made with <svg aria-hidden="true" class="w-3.5 h-3.5 text-primary fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg> by <a href="https://albertolicea00.vercel.app/" target="_blank" rel="noopener noreferrer"
          class="text-fg font-semibold hover:text-primary transition-colors">@albertolicea00</a>
      </p>
    </div>

  </div>
</footer>

<script is:inline>
  (function () {
    const form = document.getElementById('footer-newsletter-form');
    if (!form) return;

    const emailInput = document.getElementById('newsletter-email');
    const submitBtn = document.getElementById('newsletter-submit-btn');
    const btnText = document.getElementById('newsletter-btn-text');
    const inputWrap = document.getElementById('newsletter-input-wrap');
    const errorP = document.getElementById('newsletter-error');
    const successP = document.getElementById('newsletter-success');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() || '';

      if (!email || !email.includes('@')) {
        if (errorP) {
          errorP.textContent = 'Enter a valid email.';
          errorP.classList.remove('hidden');
        }
        return;
      }

      if (errorP) {
        errorP.textContent = '';
        errorP.classList.add('hidden');
      }

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = '…';

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            segment: 'Newsletter',
            newsletter: true,
            _hp: '',
          }),
        });

        if (!res.ok) throw new Error();

        if (inputWrap) inputWrap.classList.add('hidden');
        if (successP) successP.classList.remove('hidden');
      } catch (err) {
        if (errorP) {
          errorP.textContent = 'Something went wrong. Try again.';
          errorP.classList.remove('hidden');
        }
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Subscribe';
      }
    });
  })();
</script>
