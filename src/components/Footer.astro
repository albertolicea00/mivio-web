---
// Footer.astro — Vanilla JS Footer
---

<footer class="footer-bar py-12 px-6 mt-12 border-t border-subtle bg-page">
  <div class="max-w-6xl mx-auto px-4 text-sm text-fg-faint">

    <!-- Top: brand + columns in one row on desktop -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-10">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <img src="/static/images/mivio-icon.webp" alt="Mivio" width="28" height="28" class="w-7 h-7 rounded-md" />
          <span class="text-fg font-bold text-lg">Mivio</span>
        </div>
        <p class="leading-relaxed text-xs">The ultimate multi-platform media experience. Bring your own media.</p>
      </div>

      <!-- Products -->
      <div class="flex flex-col gap-3">
        <h3 class="text-fg font-semibold mb-1">Products</h3>
        <a href="download.html" class="hover:text-fg transition-colors w-fit">Native Apps</a>
        <a href="cloud.html" class="hover:text-fg transition-colors w-fit">Cloud Space</a>
        <a href="b2b.html" class="hover:text-fg transition-colors w-fit">B2B</a>
        <a href="marketplace.html" class="hover:text-fg transition-colors w-fit">VR Marketplace</a>
      </div>

      <!-- Resources -->
      <div class="flex flex-col gap-3">
        <h3 class="text-fg font-semibold mb-1">Resources</h3>
        <a href="manual.html" class="hover:text-fg transition-colors w-fit">User Manual</a>
        <a href="marketplace.html" class="hover:text-fg transition-colors w-fit">Developer Docs</a>
        <a href="terms.html" class="hover:text-fg transition-colors w-fit">Terms</a>
        <a href="privacy.html" class="hover:text-fg transition-colors w-fit">Privacy</a>
      </div>

      <!-- Community -->
      <div class="flex flex-col gap-3">
        <h3 class="text-fg font-semibold mb-1">Community</h3>
        <a href="https://github.com/albertolicea00" target="_blank" rel="noopener noreferrer"
          class="hover:text-fg transition-colors w-fit">GitHub</a>
        <a href="https://discord.gg/albertolicea00" target="_blank" rel="noopener noreferrer"
          class="hover:text-fg transition-colors w-fit">Discord</a>
        <a href="https://t.me/albertolicea00" target="_blank" rel="noopener noreferrer"
          class="hover:text-fg transition-colors w-fit">Telegram</a>
      </div>

      <!-- Social -->
      <div class="flex flex-col gap-3">
        <h3 class="text-fg font-semibold mb-1">Social</h3>
        <a href="https://x.com/albertolicea00" target="_blank" rel="noopener noreferrer" class="hover:text-fg transition-colors w-fit">X (Twitter)</a>
        <a href="https://linkedin.com/in/albertolicea00" target="_blank" rel="noopener noreferrer" class="hover:text-fg transition-colors w-fit">LinkedIn</a>
        <a href="https://instagram.com/albertolicea00" target="_blank" rel="noopener noreferrer" class="hover:text-fg transition-colors w-fit">Instagram</a>
      </div>

    </div>

    <!-- Newsletter -->
    <div
      class="border-t border-subtle pt-6 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
    >
      <div class="shrink-0">
        <p class="text-fg font-semibold text-sm">Stay in the loop</p>
        <p class="text-xs text-fg-faint mt-0.5">Product updates and early access announcements.</p>
      </div>

      <form id="footer-newsletter-form" class="flex flex-col gap-1.5 sm:items-end">
        <div id="newsletter-input-wrap" class="flex gap-2">
          <input
            id="newsletter-email"
            type="email"
            placeholder="you@example.com"
            required
            autocomplete="email"
            class="rounded-xl border border-subtle bg-surface px-4 py-2 text-sm text-fg placeholder:text-fg-faint focus:outline-none focus:border-primary/50 transition-colors w-52"
          />
          <button
            type="submit"
            id="newsletter-submit-btn"
            class="btn-primary text-white font-semibold px-5 py-2 rounded-xl text-sm disabled:opacity-60 whitespace-nowrap shrink-0"
          >
            <span id="newsletter-btn-text">Subscribe</span>
          </button>
        </div>
        <p id="newsletter-error" class="hidden text-xs text-red-400"></p>
        <p id="newsletter-success" class="hidden text-xs text-primary font-semibold">You're subscribed!</p>
      </form>
    </div>

    <!-- Bottom: made with love — centered -->
    <div class="border-t border-subtle pt-6 flex justify-center">
      <p class="flex items-center gap-1 text-xs">
        Made with <svg aria-hidden="true" class="w-3.5 h-3.5 text-primary fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg> by <a href="https://albertolicea00.vercel.app/" target="_blank" rel="noopener noreferrer"
          class="text-fg font-semibold hover:text-primary transition-colors">@albertolicea00</a>
      </p>
    </div>

  </div>
</footer>

<script is:inline>
  (function () {
    const form = document.getElementById('footer-newsletter-form');
    if (!form) return;

    const emailInput = document.getElementById('newsletter-email');
    const submitBtn = document.getElementById('newsletter-submit-btn');
    const btnText = document.getElementById('newsletter-btn-text');
    const inputWrap = document.getElementById('newsletter-input-wrap');
    const errorP = document.getElementById('newsletter-error');
    const successP = document.getElementById('newsletter-success');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() || '';

      if (!email || !email.includes('@')) {
        if (errorP) {
          errorP.textContent = 'Enter a valid email.';
          errorP.classList.remove('hidden');
        }
        return;
      }

      if (errorP) {
        errorP.textContent = '';
        errorP.classList.add('hidden');
      }

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = '…';

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            segment: 'Newsletter',
            newsletter: true,
            _hp: '',
          }),
        });

        if (!res.ok) throw new Error();

        if (inputWrap) inputWrap.classList.add('hidden');
        if (successP) successP.classList.remove('hidden');
      } catch (err) {
        if (errorP) {
          errorP.textContent = 'Something went wrong. Try again.';
          errorP.classList.remove('hidden');
        }
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Subscribe';
      }
    });
  })();
</script>
