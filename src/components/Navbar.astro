---
// Navbar.astro — Vanilla JS Navbar & Theme Toggle
---

<a href="#main-content" class="skip-link">Skip to main content</a>
<nav id="main-nav" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">

  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="index.html" class="flex items-center gap-2">
      <img src="/static/images/mivio-icon.webp" alt="Mivio" width="32" height="32" class="w-8 h-8 rounded-lg" />
      <span class="font-bold text-lg tracking-tight text-fg">Mivio</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8 text-sm text-fg-subtle">
      <a href="index.html" class="hover:text-fg transition-colors">Home</a>
      <a href="download.html" class="hover:text-fg transition-colors">Native Apps</a>
      <a href="cloud.html" class="hover:text-fg transition-colors">Cloud Space</a>
      <a href="b2b.html" class="hover:text-fg transition-colors">B2B</a>
      <a href="marketplace.html" class="hover:text-fg transition-colors">VR Marketplace</a>
    </div>

    <!-- Right controls (desktop) -->
    <div class="hidden md:flex items-center gap-3">
      <button
        type="button"
        class="theme-toggle-btn toggle-pill rounded-full w-9 h-9 flex items-center justify-center"
        aria-label="Switch theme"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            class="theme-icon-path"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 1 0 0 10A5 5 0 0 0 12 7z"
          />
        </svg>
      </button>
      <a href="download.html" class="btn-primary text-white text-sm font-semibold px-5 py-2 rounded-full">Download free</a>
    </div>

    <!-- Mobile controls -->
    <div class="flex md:hidden items-center gap-2">
      <button
        type="button"
        class="theme-toggle-btn toggle-pill rounded-full w-8 h-8 flex items-center justify-center"
        aria-label="Switch theme"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            class="theme-icon-path"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 1 0 0 10A5 5 0 0 0 12 7z"
          />
        </svg>
      </button>

      <button
        type="button"
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="text-fg-subtle hover:text-fg w-8 h-8 flex items-center justify-center"
      >
        <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            id="mobile-menu-icon"
            d="M4 6h16M4 12h16M4 18h16"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden nav-blur border-subtle border-t bg-surface px-6 py-4 flex-col gap-4 text-sm text-fg-subtle"
  >
    <a href="index.html" class="mobile-nav-link hover:text-fg transition-colors">Home</a>
    <a href="download.html" class="mobile-nav-link hover:text-fg transition-colors">Native Apps</a>
    <a href="cloud.html" class="mobile-nav-link hover:text-fg transition-colors">Cloud Space</a>
    <a href="b2b.html" class="mobile-nav-link hover:text-fg transition-colors">B2B</a>
    <a href="marketplace.html" class="mobile-nav-link hover:text-fg transition-colors">VR Marketplace</a>
    <a
      href="download.html"
      class="mobile-nav-link btn-primary text-white font-semibold px-5 py-2.5 rounded-full text-center"
    >Download free</a>
  </div>
</nav>

<script is:inline>
  (function () {
    const nav = document.getElementById('main-nav');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileIcon = document.getElementById('mobile-menu-icon');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    const themeButtons = document.querySelectorAll('.theme-toggle-btn');

    // Scroll state
    function updateScroll() {
      if (!nav) return;
      if (window.scrollY > 40) {
        nav.classList.add('nav-scrolled', 'nav-blur');
      } else {
        nav.classList.remove('nav-scrolled', 'nav-blur');
      }
    }
    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();

    // Mobile menu toggle
    const hamburgerPath = 'M4 6h16M4 12h16M4 18h16';
    const closePath = 'M6 18L18 6M6 6l12 12';

    function setMobileMenu(open) {
      if (!mobileMenu || !mobileBtn) return;
      mobileBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('flex');
        if (mobileIcon) mobileIcon.setAttribute('d', closePath);
      } else {
        mobileMenu.classList.remove('flex');
        mobileMenu.classList.add('hidden');
        if (mobileIcon) mobileIcon.setAttribute('d', hamburgerPath);
      }
    }

    mobileBtn?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.contains('flex');
      setMobileMenu(!isOpen);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => setMobileMenu(false));
    });

    // Theme toggle
    const sunPath =
      'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 1 0 0 10A5 5 0 0 0 12 7z';
    const moonPath = 'M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z';

    function updateThemeUI(isDark) {
      themeButtons.forEach((btn) => {
        btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        const path = btn.querySelector('.theme-icon-path');
        if (path) {
          path.setAttribute('d', isDark ? sunPath : moonPath);
        }
      });
    }

    const initialDark = !document.documentElement.classList.contains('light');
    updateThemeUI(initialDark);

    themeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isCurrentlyLight = document.documentElement.classList.contains('light');
        const nextDark = isCurrentlyLight; // if light now, next is dark
        if (nextDark) {
          document.documentElement.classList.remove('light');
          localStorage.setItem('mivio-theme', 'dark');
        } else {
          document.documentElement.classList.add('light');
          localStorage.setItem('mivio-theme', 'light');
        }
        updateThemeUI(nextDark);
      });
    });
  })();
</script>
