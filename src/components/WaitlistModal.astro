---
// WaitlistModal.astro — Vanilla JS Waitlist Modal
---

<div
  id="waitlist-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center px-4 transition-opacity duration-200 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="waitlist-modal-title"
>
  <!-- Backdrop -->
  <div id="waitlist-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm cursor-pointer"></div>

  <!-- Panel -->
  <div class="relative w-full max-w-md card rounded-3xl p-8 flex flex-col gap-6 shadow-2xl z-10">

    <!-- Close -->
    <button
      type="button"
      id="waitlist-close-btn"
      aria-label="Close"
      class="absolute top-4 right-4 text-fg-faint hover:text-fg transition-colors w-8 h-8 flex items-center justify-center rounded-full"
    >
      <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Header -->
    <div class="flex flex-col gap-2">
      <h2 id="waitlist-modal-title" class="text-xl font-extrabold text-fg">Join the waitlist</h2>
      <p class="text-fg-subtle text-sm">
        Be the first to know when <span id="waitlist-segment" class="text-fg font-semibold capitalize"></span> launches. 
      </p>
    </div>

    <!-- Success state -->
    <div id="waitlist-success" class="hidden flex-col items-center gap-3 py-4 text-center">
      <div class="w-12 h-12 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
        <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <p class="font-bold text-fg">You're on the list!</p>
      <p class="text-fg-subtle text-sm">We'll email you as soon as we launch.</p>
      <button type="button" id="waitlist-success-close-btn" class="btn-primary text-white font-semibold px-6 py-2.5 rounded-full text-sm mt-2">
        Got it
      </button>
    </div>

    <!-- Form state -->
    <form id="waitlist-form" class="flex flex-col gap-4">
      <!-- Honeypot -->
      <input type="text" name="_hp" id="waitlist-hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
      
      <div class="flex flex-col gap-1.5">
        <label for="waitlist-email" class="text-xs font-semibold text-fg-subtle uppercase tracking-wide">Email address</label>
        <input
          id="waitlist-email"
          type="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
          class="w-full rounded-xl border border-subtle bg-surface px-4 py-3 text-sm text-fg placeholder:text-fg-faint focus:outline-none focus:border-primary/50 transition-colors"
        />
        <p id="waitlist-error" class="hidden text-xs text-red-400 mt-0.5"></p>
      </div>

      <button
        type="submit"
        id="waitlist-submit"
        class="btn-primary text-white font-bold px-6 py-3 rounded-2xl text-sm flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <svg id="waitlist-spinner" aria-hidden="true" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
        </svg>
        <span id="waitlist-btn-text">Notify me at launch</span>
      </button>

      <p class="text-center text-xs text-fg-faint">Your email is used only to notify you. Unsubscribe anytime.</p>
    </form>

  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('waitlist-modal');
    if (!modal) return;

    const backdrop = document.getElementById('waitlist-backdrop');
    const closeBtn = document.getElementById('waitlist-close-btn');
    const successCloseBtn = document.getElementById('waitlist-success-close-btn');
    const segmentSpan = document.getElementById('waitlist-segment');
    const form = document.getElementById('waitlist-form');
    const successDiv = document.getElementById('waitlist-success');
    const emailInput = document.getElementById('waitlist-email');
    const hpInput = document.getElementById('waitlist-hp');
    const errorP = document.getElementById('waitlist-error');
    const submitBtn = document.getElementById('waitlist-submit');
    const spinner = document.getElementById('waitlist-spinner');
    const btnText = document.getElementById('waitlist-btn-text');

    let currentSegment = '';

    function openModal(segment = 'Mivio Apps') {
      currentSegment = segment;
      if (segmentSpan) segmentSpan.textContent = segment;
      modal.setAttribute('aria-label', 'Join waitlist for ' + segment);
      
      // Reset form state
      if (form) {
        form.reset();
        form.classList.remove('hidden');
      }
      if (successDiv) {
        successDiv.classList.remove('flex');
        successDiv.classList.add('hidden');
      }
      if (errorP) {
        errorP.textContent = '';
        errorP.classList.add('hidden');
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        if (spinner) spinner.classList.add('hidden');
        if (btnText) btnText.textContent = 'Notify me at launch';
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      // Trigger reflow for opacity transition
      void modal.offsetWidth;
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');

      setTimeout(() => emailInput?.focus(), 50);
    }

    function closeModal() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }, 200);
    }

    window.openWaitlist = openModal;
    window.closeWaitlist = closeModal;

    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    successCloseBtn?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-waitlist]');
      if (trigger) {
        e.preventDefault();
        const segment = trigger.getAttribute('data-waitlist') || 'Mivio Apps';
        openModal(segment);
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim() || '';
      if (!email || !email.includes('@')) {
        if (errorP) {
          errorP.textContent = 'Please enter a valid email.';
          errorP.classList.remove('hidden');
        }
        return;
      }

      if (errorP) {
        errorP.textContent = '';
        errorP.classList.add('hidden');
      }

      if (submitBtn) submitBtn.disabled = true;
      if (spinner) spinner.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Joining…';

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            segment: currentSegment,
            _hp: hpInput?.value || '',
          }),
        });

        if (!res.ok) {
          const errText = await res.text();
          throw new Error(errText || 'Request failed');
        }

        form.classList.add('hidden');
        if (successDiv) {
          successDiv.classList.remove('hidden');
          successDiv.classList.add('flex');
        }
      } catch (err) {
        if (errorP) {
          errorP.textContent = 'Something went wrong. Try again later.';
          errorP.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (spinner) spinner.classList.add('hidden');
        if (btnText) btnText.textContent = 'Notify me at launch';
      }
    });
  })();
</script>
