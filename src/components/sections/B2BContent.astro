---
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import WaitlistModal from '../WaitlistModal.astro';
import PageHero from '../ui/PageHero.astro';
import LicenseModelCard from '../ui/LicenseModelCard.astro';
---

<Navbar />

<main id="main-content" class="pt-32 pb-24 px-6 max-w-5xl mx-auto">

  <PageHero class="mb-20 text-center">
    Mivio for<br /><span class="gradient-text">your business.</span>
    <Fragment slot="description">
      Deploy Mivio at scale across your organization, or ship it under your own brand. Custom licensing agreements for hotels, universities, academies, media companies, and any organization that needs a professional media experience.
    </Fragment>
  </PageHero>

  <section class="flex flex-col md:flex-row justify-center gap-6 mb-20">
    <LicenseModelCard
      title="Enterprise Deployment"
      description="Roll out Mivio across your entire organization. Manage users, control access, and provide a unified media experience — all under your IT infrastructure."
      features={[
        'Centralized user management',
        'On-premise or cloud-hosted',
        'All platforms included',
        'Dedicated support channel',
      ]}
      note="Ideal for: hotels, hospitals, universities, academies, corporate campuses."
    >
      <svg slot="icon" aria-hidden="true" class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
    </LicenseModelCard>

    <LicenseModelCard
      title="White-Label Licensing"
      description="Ship Mivio under your own brand, with your logo, your colors, and your app store presence. Full commercial rights with a custom licensing agreement."
      features={[
        'Custom branding & identity',
        'Commercial redistribution rights',
        'Source access (negotiated)',
        'Co-development available',
      ]}
      note="Ideal for: media companies, telecom operators, set-top box manufacturers, streaming platforms."
      borderClass="border-primary/30"
    >
      <svg slot="icon" aria-hidden="true" class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
    </LicenseModelCard>
  </section>

  <section class="p-8 mb-20">
    <h2 class="font-bold text-xl mb-4">Pricing Model</h2>
    <p class="text-fg-subtle text-sm mb-6 leading-relaxed">B2B licensing is not a fixed price list. Every organization has different scale, requirements, and goals. Pricing is negotiated based on the scope of the agreement.</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-sm">
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span class="font-semibold text-fg">Per-seat license</span>
        </div>
        <span class="text-fg-subtle">For enterprise deployments with a defined user base.</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="font-semibold text-fg">Revenue share</span>
        </div>
        <span class="text-fg-subtle">For white-label products that generate commercial revenue.</span>
      </div>
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
          <span class="font-semibold text-fg">One-time license</span>
        </div>
        <span class="text-fg-subtle">For specific deployments or internal-use tools without recurring billing.</span>
      </div>
    </div>
  </section>

  <section class="relative text-center">
    <h2 class="font-bold text-2xl text-fg mb-3">Ready to talk?</h2>
    <p class="text-fg-subtle mb-6 max-w-xl mx-auto">Tell us about your project and we'll get back to you with a proposal tailored to your needs.</p>
    <button
      type="button" data-waitlist="Mivio B2B"
      class="btn-primary text-white font-bold px-8 py-4 rounded-2xl text-base">
      Get early access
    </button>
    <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-3/4 h-32 rounded-full blur-[100px] bg-primary/30 -z-10 pointer-events-none" aria-hidden="true"></div>
  </section>

</main>

<WaitlistModal />
<Footer />
