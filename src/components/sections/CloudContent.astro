---
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import WaitlistModal from '../WaitlistModal.astro';
---

<Navbar />

<main id="main-content" class="pt-32 pb-24 px-6 max-w-6xl mx-auto">
  <header class="text-center mb-20">
    <h1 class="font-extrabold text-4xl sm:text-5xl md:text-6xl mb-6 text-fg leading-tight">
      Your data.<br /><span class="gradient-text">Always with you.</span>
    </h1>
  </header>

  <!-- What is Mivio Cloud & How it compares to Drive / iCloud -->
  <section class="mb-24 pt-8 border-t border-subtle">
    <div class="max-w-3xl mx-auto text-center mb-14">
      <h2 class="font-extrabold text-3xl sm:text-4xl text-fg mb-4">
        Why Mivio Cloud instead of Drive or iCloud?
      </h2>
      <p class="text-fg-subtle text-base leading-relaxed">
        Services like Google Drive, iCloud, or Dropbox were built for office documents and photos — not for streaming 50GB high-bitrate movies, 8K spatial video, and lossless audio directly to VR headsets and high-end screens.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto text-left">
      <div class="flex items-start gap-3.5">
        <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        <div class="flex flex-col gap-1">
          <h3 class="font-bold text-fg text-base">High-Bitrate Media Streaming</h3>
          <p class="text-fg-subtle text-sm leading-relaxed">
            Traditional drives throttle video bandwidth and force you to wait for 40GB+ downloads. Mivio Cloud is built to stream massive spatial videos and 4K/8K remuxes with instant seeking and zero lag.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <div class="flex flex-col gap-1">
          <h3 class="font-bold text-fg text-base">Absolute Privacy & Zero Scanning</h3>
          <p class="text-fg-subtle text-sm leading-relaxed">
            Unlike Big Tech cloud storage that scans and indexes files for algorithms or AI models, your Mivio Cloud instance is 100% private, isolated, and encrypted.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        <div class="flex flex-col gap-1">
          <h3 class="font-bold text-fg text-base">No NAS or Server Headaches</h3>
          <p class="text-fg-subtle text-sm leading-relaxed">
            Forget buying noisy home servers, forwarding router ports, or configuring complex Plex/Jellyfin setups. Mivio Cloud is fully managed and ready in seconds.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
        <div class="flex flex-col gap-1">
          <h3 class="font-bold text-fg text-base">Seamless Mivio Ecosystem Sync</h3>
          <p class="text-fg-subtle text-sm leading-relaxed">
            Watch progress, bookmarks, virtual 3D cinema environments, and audio preferences sync natively across Meta Quest, Apple Vision Pro, mobile, and smart TVs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What we offer & Custom Plan Contact Form -->
  <section id="custom-plans" class="mb-20 pt-8 border-t border-subtle">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start max-w-5xl mx-auto">
      
      <!-- What we offer -->
      <div class="flex flex-col gap-6 text-left w-full max-w-xl mx-auto lg:max-w-none">
        <div>
          <span class="text-primary text-xs font-bold tracking-widest uppercase mb-2 block">Custom Solutions</span>
          <h2 class="font-extrabold text-2xl sm:text-3xl text-fg mb-3">
            What Mivio Cloud offers
          </h2>
          <p class="text-fg-subtle text-sm sm:text-base leading-relaxed">
            Need tailored storage capacity, dedicated resources, or direct support for a large media collection? We configure custom cloud instances tailored to your exact library size.
          </p>
        </div>

        <div class="flex flex-col gap-5 mt-2">
          <div class="flex items-start gap-3">
            <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7M4 7c0-2 1.5-3 3.5-3h9c2 0 3.5 1 3.5 3M4 7h16m-16 5c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3m-16 0h16"/>
            </svg>
            <div class="flex flex-col gap-1">
              <h3 class="font-bold text-fg text-base">Flexible storage</h3>
              <p class="text-fg-subtle text-sm leading-relaxed">
                Scale your capacity from a few terabytes to 10 TB, 30 TB, or beyond. Pay only for what your media collection actually requires without artificial caps.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
            <div class="flex flex-col gap-1">
              <h3 class="font-bold text-fg text-base">Dedicated server</h3>
              <p class="text-fg-subtle text-sm leading-relaxed">
                Isolated cloud instance with dedicated high-speed bandwidth, ensuring zero bottlenecks when streaming high-bitrate 4K, 8K, and spatial video.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <div class="flex flex-col gap-1">
              <h3 class="font-bold text-fg text-base">Direct personal support</h3>
              <p class="text-fg-subtle text-sm leading-relaxed">
                Direct 1-on-1 assistance with onboarding, setup, and media migration directly from our engineering team.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Standard Form ("un formulario normal") -->
      <div class="flex flex-col w-full max-w-xl mx-auto lg:max-w-none relative" style="background:rgba(224,112,79,.15);border:1px solid rgba(242,236,223,.14);border-radius:16px;padding:14px 14px 12px;box-shadow:0 24px 60px rgba(0,0,0,.42),inset 0 1px 0 rgba(242,236,223,.10)">
        <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:2px 4px 12px"></div>
        <div class="flex flex-col flex-1 p-6 sm:p-8 text-left relative" style="background:rgba(255,255,255,.58);backdrop-filter:blur(22px) brightness(3.1) saturate(.72);-webkit-backdrop-filter:blur(22px) brightness(3.1) saturate(.72);border:1px solid rgba(255,255,255,.42);border-radius:12px;color:#241d15;">
          <h3 class="font-extrabold text-2xl mt-1 mb-2">Build your plan</h3>
          <p class="text-xs sm:text-sm mb-6 leading-relaxed" style="color:rgba(36, 29, 21, 0.8);">
            Tell us about your collection and budget. We'll configure and recommend the setup that fits your needs.
          </p>

        <form id="cloud-contact-form" class="flex flex-col gap-3.5">
          <!-- Contact -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="group rounded-xl border border-subtle bg-surface-alt/40 px-3.5 pt-2 pb-2 transition-all focus-within:border-primary/50 focus-within:bg-surface-alt/70 focus-within:ring-1 focus-within:ring-primary/20">
              <label for="cloud-name" class="block text-[11px] font-semibold text-fg-subtle uppercase tracking-wider group-focus-within:text-primary transition-colors">
                Your Name
              </label>
              <input
                id="cloud-name"
                name="name"
                type="text"
                required
                placeholder="e.g. Alex Rivera"
                class="w-full bg-transparent pt-0.5 text-sm text-fg placeholder:text-fg-faint/50 focus:outline-none"
              />
            </div>

            <div class="group rounded-xl border border-subtle bg-surface-alt/40 px-3.5 pt-2 pb-2 transition-all focus-within:border-primary/50 focus-within:bg-surface-alt/70 focus-within:ring-1 focus-within:ring-primary/20">
              <label for="cloud-email" class="block text-[11px] font-semibold text-fg-subtle uppercase tracking-wider group-focus-within:text-primary transition-colors">
                Email Address
              </label>
              <input
                id="cloud-email"
                name="email"
                type="email"
                required
                placeholder="alex@example.com"
                class="w-full bg-transparent pt-0.5 text-sm text-fg placeholder:text-fg-faint/50 focus:outline-none"
              />
            </div>
          </div>

          <!-- Media & Quality -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="group relative rounded-xl border border-subtle bg-surface-alt/40 px-3.5 pt-2 pb-2 transition-all focus-within:border-primary/50 focus-within:bg-surface-alt/70 focus-within:ring-1 focus-within:ring-primary/20">
              <label for="cloud-library-size" class="block text-[11px] font-semibold text-fg-subtle uppercase tracking-wider group-focus-within:text-primary transition-colors">
                Movies / Series Count
              </label>
              <div class="relative flex items-center mt-0.5">
                <select
                  id="cloud-library-size"
                  name="library_size"
                  class="w-full bg-transparent pr-6 text-sm text-fg focus:outline-none cursor-pointer appearance-none"
                >
                  <option value="Under 100 titles" class="bg-surface text-fg">Under 100 movies / series</option>
                  <option value="100 – 500 titles" selected class="bg-surface text-fg">100 – 500 movies / series</option>
                  <option value="500 – 2,000 titles" class="bg-surface text-fg">500 – 2,000 movies / series</option>
                  <option value="2,000+ titles" class="bg-surface text-fg">2,000+ movies / series</option>
                  <option value="Personal files & music" class="bg-surface text-fg">Personal videos & music</option>
                </select>
                <svg aria-hidden="true" class="w-4 h-4 text-fg-subtle group-focus-within:text-primary pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </div>

            <div class="group relative rounded-xl border border-subtle bg-surface-alt/40 px-3.5 pt-2 pb-2 transition-all focus-within:border-primary/50 focus-within:bg-surface-alt/70 focus-within:ring-1 focus-within:ring-primary/20">
              <label for="cloud-resolution" class="block text-[11px] font-semibold text-fg-subtle uppercase tracking-wider group-focus-within:text-primary transition-colors">
                Video Quality
              </label>
              <div class="relative flex items-center mt-0.5">
                <select
                  id="cloud-resolution"
                  name="resolution"
                  class="w-full bg-transparent pr-6 text-sm text-fg focus:outline-none cursor-pointer appearance-none"
                >
                  <option value="720p HD" class="bg-surface text-fg">720p HD</option>
                  <option value="1080p Full HD" selected class="bg-surface text-fg">1080p Full HD</option>
                  <option value="4K Ultra HD & HDR" class="bg-surface text-fg">4K Ultra HD & HDR</option>
                  <option value="8K Spatial Video / VR" class="bg-surface text-fg">8K Spatial Video / VR</option>
                  <option value="Remux / Lossless" class="bg-surface text-fg">Remux / Lossless</option>
                  <option value="Mixed qualities" class="bg-surface text-fg">Mixed qualities</option>
                </select>
                <svg aria-hidden="true" class="w-4 h-4 text-fg-subtle group-focus-within:text-primary pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Budget -->
          <div class="group relative rounded-xl border border-subtle bg-surface-alt/40 px-3.5 pt-2 pb-2 transition-all focus-within:border-primary/50 focus-within:bg-surface-alt/70 focus-within:ring-1 focus-within:ring-primary/20">
            <label for="cloud-budget" class="block text-[11px] font-semibold text-fg-subtle uppercase tracking-wider group-focus-within:text-primary transition-colors">
              Monthly Budget
            </label>
            <div class="relative flex items-center mt-0.5">
              <select
                id="cloud-budget"
                name="budget"
                class="w-full bg-transparent pr-6 text-sm text-fg focus:outline-none cursor-pointer appearance-none"
              >
                <option value="Flexible / Best value" selected class="bg-surface text-fg">Flexible / Recommend the best value</option>
                <option value="Under $10/mo" class="bg-surface text-fg">Under $10 / month</option>
                <option value="$10 – $25/mo" class="bg-surface text-fg">$10 – $25 / month</option>
                <option value="$25 – $50/mo" class="bg-surface text-fg">$25 – $50 / month</option>
                <option value="$50+/mo (Dedicated)" class="bg-surface text-fg">$50+ / month (Dedicated server)</option>
              </select>
              <svg aria-hidden="true" class="w-4 h-4 text-fg-subtle group-focus-within:text-primary pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>

          <!-- Message -->
          <div class="group rounded-xl border border-subtle bg-surface-alt/40 px-3.5 pt-2 pb-2 transition-all focus-within:border-primary/50 focus-within:bg-surface-alt/70 focus-within:ring-1 focus-within:ring-primary/20">
            <label for="cloud-message" class="block text-[11px] font-semibold text-fg-subtle uppercase tracking-wider group-focus-within:text-primary transition-colors">
              Additional Notes
            </label>
            <textarea
              id="cloud-message"
              name="message"
              rows="2.5"
              placeholder="Any specific requests, existing equipment, or notes..."
              class="w-full bg-transparent pt-0.5 text-sm text-fg placeholder:text-fg-faint/50 focus:outline-none resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="cloud-submit-btn"
            class="btn-primary text-white font-bold px-6 py-3 rounded-2xl text-sm inline-flex items-center gap-2 mt-1 self-start cursor-pointer"
          >
            <span>Get tailored plan</span>
            <svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>
        </div>
        <div style="height:10px;border-radius:3px;background:repeating-linear-gradient(90deg,rgba(242,236,223,.13) 0 14px,transparent 14px 28px);margin:12px 4px 2px"></div>
      </div>

    </div>
  </section>
</main>

<WaitlistModal />
<Footer />

<script is:inline>
  (function () {
    const form = document.getElementById('cloud-contact-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const name = document.getElementById('cloud-name')?.value || '';
      const email = document.getElementById('cloud-email')?.value || '';
      const librarySize = document.getElementById('cloud-library-size')?.value || '';
      const resolution = document.getElementById('cloud-resolution')?.value || '';
      const budget = document.getElementById('cloud-budget')?.value || '';
      const message = document.getElementById('cloud-message')?.value || '';

      const subject = `Mivio Cloud Plan Inquiry - ${name}`;
      const body = `Name: ${name}\nEmail: ${email}\nMovies / Series: ${librarySize}\nVideo Quality: ${resolution}\nMonthly Budget: ${budget}\n\nAdditional Notes:\n${message}`;

      window.location.href = `mailto:cloud@mivio.app?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  })();
</script>
