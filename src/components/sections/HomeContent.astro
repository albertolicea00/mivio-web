---
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import WaitlistModal from '../WaitlistModal.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import StatItem from '../ui/StatItem.astro';
import FeatureCard from '../ui/FeatureCard.astro';
import DeviceCard from '../ui/DeviceCard.astro';
import FAQItem from '../ui/FAQItem.astro';
import PromoCard from '../ui/PromoCard.astro';
import Marquee from '../ui/Marquee.astro';

const technicalSpecs = [
  {
    category: 'Video Formats',
    icon: 'video',
    reverse: false,
    speed: '42s',
    items: [
      '3GP', 'ASF', 'AV1', 'AVI', 'BDMV', 'DivX', 'DVDMEDIA', 'DVR-MS', 'FLV',
      'H.264 (AVC)', 'H.265 (HEVC)', 'H.266 (VVC)', 'ISO/IMG', 'M4V', 'MKV', 'MOV',
      'MP4', 'MPEG-1/MPEG-2', 'MTS/M2TS', 'MXF', 'OGM', 'OGV', 'RMVB', 'STRM',
      'STRMLNK', 'TS', 'VC-1', 'VIDEO_TS', 'VOB', 'VP8', 'VP9', 'WebM', 'WMV', 'WTV',
    ],
  },
  {
    category: 'Audio Formats',
    icon: 'audio',
    reverse: true,
    speed: '28s',
    items: [
      'AAC', 'AIFF', 'Dolby Digital (AC3)', 'Dolby Digital Plus (E-AC3)',
      'Dolby TrueHD', 'DTS', 'DTS-HD MA', 'FLAC', 'MP3', 'Ogg', 'PCM',
      'TTA', 'WAV', 'WMA',
    ],
  },
  {
    category: 'Subtitles',
    icon: 'subtitles',
    reverse: false,
    speed: '34s',
    items: [
      'DVB', 'DVDSub', 'MicroDVD', 'MPL2', 'PGS', 'SMI', 'SRT', 'SSA/ASS',
      'SUB', 'SUP', 'Timed Text', 'TMP', 'TXT', 'VobSub', 'VTT', 'XSUB',
    ],
  },
  {
    category: 'Network Protocols',
    icon: 'network',
    reverse: true,
    speed: '24s',
    items: [
      'SMB', 'NFS', 'FTP', 'FTPES', 'FTPS', 'SFTP', 'HTTP/HTTPS', 'UPnP/DLNA', 'WebDAV',
    ],
  },
  {
    category: 'Media Servers',
    icon: 'servers',
    reverse: false,
    speed: '20s',
    items: [
      'Emby', 'Jellyfin', 'Plex',
    ],
  },
  {
    category: 'Cloud Services',
    icon: 'cloud',
    reverse: true,
    speed: '32s',
    items: [
      'Dropbox', 'Google Drive', 'OneDrive', 'Box', 'pCloud', 'Yandex.Disk',
      'MEGA', 'Aliyun Drive', '123 Drive', '115 Drive', 'Baidu NetDisk', 'GuangYaPan',
    ],
  }
];
---

<Navbar />

<!-- ==============================================================
     HERO
============================================================== -->
<section id="main-content"
  class="relative isolate min-h-screen flex flex-col items-center justify-center text-center px-4 sm:px-6 pt-20 sm:pt-24 pb-10 sm:pb-16 overflow-hidden hero-glow">

  <!-- Background Video -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0" aria-hidden="true">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="w-full h-full object-cover opacity-45"
    >
      <source src="/static/videos/collage-movies-right.webm" type="video/webm" />
      <source src="/static/videos/collage-movies-right.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-b from-[#121212]/60 via-[#121212]/30 to-[#121212]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,#121212_90%)]"></div>
  </div>

  <div class="absolute inset-0 overflow-hidden pointer-events-none z-10" aria-hidden="true">
    <div class="absolute top-10 left-10 w-2 h-2 rounded-full ping-orange animate-ping"></div>
    <div class="absolute top-32 right-20 w-1.5 h-1.5 rounded-full ping-cyan animate-ping" style="animation-delay:.9s"></div>
    <div class="absolute bottom-40 left-16 w-1 h-1 rounded-full ping-orange animate-ping" style="animation-delay:1.8s"></div>
  </div>

  <h1 class="relative z-10 font-extrabold text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-tight tracking-tight max-w-4xl mb-6 text-fg">
    <span>All your multimedia</span><br />
    <span class="gradient-text">content,</span><br />
    <span>in one place.</span>
  </h1>

  <p class="relative z-10 text-fg-subtle text-lg sm:text-xl max-w-2xl mb-10 leading-relaxed">Mivio, the ultimate
    multi-platform media player. Connect your local servers, <strong>SMB</strong> or <strong>WebDAV</strong>, and
    enjoy your movies and series with automatic artwork and built-in subtitles.</p>

  <div class="relative z-10 flex flex-col sm:flex-row gap-3 sm:gap-4 mb-10 sm:mb-16 w-full sm:w-auto">
    <button type="button"
      data-waitlist="Mivio Apps"
      class="btn-primary animate-pulse-glow text-white font-bold px-8 py-4 rounded-2xl text-base flex items-center justify-center gap-3 shadow-lg">
      <svg aria-hidden="true" class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      Join the waitlist
    </button>

    <a href="cloud.html"
      class="btn-outline text-fg-muted font-semibold px-8 py-4 rounded-2xl text-base flex items-center justify-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
      </svg>
      <span>Explore Cloud</span>
    </a>
  </div>

  <!-- Promo Video — disabled for now -->
  <div class="relative w-full max-w-5xl mx-auto z-10 group" style="display: none;">
    <div class="p-2 sm:p-3 rounded-[2.5rem] bg-gradient-to-b from-white/10 to-white/5 border border-white/10 shadow-[0_0_80px_-20px_rgba(255,107,0,0.3)] backdrop-blur-md transition-all duration-500 hover:shadow-[0_0_100px_-20px_rgba(255,107,0,0.4)]">
      <div class="relative w-full bg-surface-alt rounded-[2rem] overflow-hidden border border-subtle shadow-inner">
        <div class="absolute top-0 inset-x-0 h-10 bg-gradient-to-b from-black/60 to-transparent z-20 flex items-center px-5 gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
          <div class="w-3 h-3 rounded-full bg-[#FF5F56] border border-white/10"></div>
          <div class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-white/10"></div>
          <div class="w-3 h-3 rounded-full bg-[#27C93F] border border-white/10"></div>
        </div>
        <div class="relative w-full aspect-video">
          <iframe class="absolute inset-0 w-full h-full"
            src="https://www.youtube.com/embed/5PSMwDA76mw?autoplay=0&rel=0&modestbranding=1&controls=1&iv_load_policy=3&fs=0"
            title="Mivio Promo Video" frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator (Minimal Line) -->
  <a
    href="#features"
    class="absolute bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 text-fg-subtle/60 hover:text-fg-subtle transition-colors duration-300 group select-none"
    aria-label="Scroll to explore"
  >
    <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-fg-subtle/60 group-hover:text-fg transition-colors">
      Scroll
    </span>
    <div class="w-px h-8 bg-white/10 relative overflow-hidden rounded-full">
      <div class="w-full h-1/2 bg-gradient-to-b from-transparent via-primary/80 to-transparent scroll-line-runner"></div>
    </div>
  </a>
</section>

<!-- ==============================================================
     STATS BAR
============================================================== -->
<div class="stats-bar py-8">
  <div class="max-w-5xl mx-auto px-6 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
    <StatItem value="SMB" label="Samba / NAS" />
    <StatItem value="WebDAV" label="Local network" />
    <StatItem value="TMDB" label="Metadata" />
    <StatItem value="OpenSubs" label="Subtitles" />
  </div>
</div>

<!-- ==============================================================
     FEATURES (Horizontal Scroll Track — openmontage style)
============================================================== -->
<section id="features" class="features-runway relative bg-page">
  <div data-ref="pinWrap" class="features-pin-wrap relative flex items-center overflow-hidden">
    <!-- Cinema Theater Background -->
    <div class="features-bg absolute inset-0 z-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
      <img
        src="/static/images/cinema-banner-2.webp"
        alt=""
        class="w-full h-full object-cover object-bottom translate-y-12 sm:translate-y-20"
        loading="eager"
      />
      <!-- Gradient overlay: darker at the top (seamless transition), clear at the bottom to showcase cinema seats -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#121212] via-[#121212]/50 via-35% to-transparent"></div>
      <div class="absolute inset-y-0 left-0 w-1/4 bg-gradient-to-r from-[#121212]/50 to-transparent"></div>
    </div>

    <div
      data-ref="track"
      class="features-track relative -top-16 sm:-top-32 z-20 flex gap-6 sm:gap-8 items-center will-change-transform"
    >
      <!-- Intro Column / Scroll Cue -->
      <div class="shrink-0 w-[290px] sm:w-[340px] md:w-[380px] flex flex-col justify-center pr-2 sm:pr-6">
        <span class="text-xs font-bold uppercase tracking-widest text-primary mb-3 block">Features</span>
        <h2 class="font-extrabold text-3xl sm:text-4xl md:text-5xl text-fg leading-tight">
          <span>Everything you need,</span><br />
          <span class="gradient-text">nothing you don't.</span>
        </h2>
        <p class="text-fg-subtle text-sm sm:text-base mt-4 leading-relaxed">
          Mivio is built without bloat. High-performance playback, automated metadata, and zero server headaches.
        </p>
        <div class="flex items-center gap-2.5 font-mono text-[11px] font-bold tracking-widest text-[#78716c] uppercase mt-8">
          <span>Scroll to explore</span>
          <svg class="w-4 h-4 text-[#78716c] animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </div>

      <!-- Card 1: Network support -->
      <div class="shrink-0 w-[320px] sm:w-[380px] md:w-[420px] h-[390px] sm:h-[420px] flex flex-col">
        <FeatureCard tag="01 · PROTOCOLS" eyebrow="Network support" title="Your files, your rules">
          <svg slot="icon" class="w-7 h-7 text-[#6b635b]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12H3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2h-2
                 M5 12V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v5M5 12h14" />
            <circle cx="18" cy="17" r="1" fill="currentColor" />
          </svg>
          No matter where you store your videos. Mivio supports local
          storage and network connections via <strong>SMB</strong> and <strong>WebDAV</strong>. Connect your NAS or
          server in seconds.
        </FeatureCard>
      </div>

      <!-- Card 2: Magic metadata -->
      <div class="shrink-0 w-[320px] sm:w-[380px] md:w-[420px] h-[390px] sm:h-[420px] flex flex-col">
        <FeatureCard tag="02 · METADATA" eyebrow="Magic metadata" title="Automatic organization">
          <svg slot="icon" class="w-7 h-7 text-[#6b635b]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v4m0 0H3m4 0h4M7 8v4M17 4l-1 1m0 0-1 1m1-1 1 1m-1-1-1-1M3 20l9-9
                 M12.5 7.5l4 4-7 7H6v-3.5l6.5-6.5z" />
          </svg>
          Forget searching for names. Mivio scans your files and
          automatically downloads artwork, synopses, cast, and ratings from <strong>TMDB</strong> so your library
          looks spectacular.
        </FeatureCard>
      </div>

      <!-- Card 3: OpenSubtitles -->
      <div class="shrink-0 w-[320px] sm:w-[380px] md:w-[420px] h-[390px] sm:h-[420px] flex flex-col">
        <FeatureCard tag="03 · SUBTITLES" eyebrow="OpenSubtitles" title="Subtitles instantly">
          <svg slot="icon" class="w-7 h-7 text-[#6b635b]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M7 8h10M7 12h6m-6 4h10M3 4h18a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
          </svg>
          Missing subtitles? Search and download them directly from
          the app thanks to our <strong>OpenSubtitles</strong> integration.
        </FeatureCard>
      </div>

      <!-- Card 4: ExoPlayer -->
      <div class="shrink-0 w-[320px] sm:w-[380px] md:w-[420px] h-[390px] sm:h-[420px] flex flex-col">
        <FeatureCard tag="04 · PLAYBACK" eyebrow="ExoPlayer" title="High-performance playback">
          <svg slot="icon" class="w-7 h-7 text-[#6b635b]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke-width="1.5" />
            <path d="M10 8l6 4-6 4V8z" fill="currentColor" />
          </svg>
          Enjoy maximum performance and support for almost all video
          formats thanks to the <strong>ExoPlayer</strong>-based engine. Your progress is saved automatically.
        </FeatureCard>
      </div>

      <!-- Card 5: Cloud streaming -->
      <div class="shrink-0 w-[320px] sm:w-[380px] md:w-[420px] h-[390px] sm:h-[420px] flex flex-col">
        <FeatureCard tag="05 · CLOUD" eyebrow="Cloud streaming" title="Direct cloud access">
          <svg slot="icon" class="w-7 h-7 text-[#6b635b]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
          </svg>
          Stream directly from <strong>Google Drive</strong>, <strong>Dropbox</strong>, <strong>OneDrive</strong>, and <strong>WebDAV</strong> without downloading files first.
        </FeatureCard>
      </div>
    </div>
  </div>
</section>

<!-- ==============================================================
     COMPATIBILITY
============================================================== -->
<section id="showcase" class="pt-20 sm:pt-24 px-6 bg-page">
  <div class="max-w-6xl mx-auto">

    <SectionHeader eyebrow="Compatibility" class="text-center mb-10 sm:mb-12">
      <span>Works on every</span><br />
      <span class="gradient-text">screen you own.</span>
      <Fragment slot="description">
        <p class="text-fg-subtle mt-4 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
          One app, the entire ecosystem. Whether you're on the couch, at the desk, or on the road — Mivio adapts to your screen.
        </p>
      </Fragment>
    </SectionHeader>

    <!-- Device Mockup Frame -->
    <div class="relative w-full">
      <img
        src="/static/images/frame-devices-apple-2.webp"
        alt="Mivio on MacBook, iPad, and iPhone"
        width="1376"
        height="768"
        class="w-full h-auto object-contain"
        loading="lazy"
      />
    </div>

  </div>
</section>

<!-- ==============================================================
     PLATFORMS BAR
============================================================== -->
<div class="stats-bar py-8">
  <div class="max-w-5xl mx-auto px-6 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
    <StatItem value="Apple" label="iOS · macOS · visionOS" />
    <StatItem value="Android" label="Mobile · Tablet · TV" />
    <StatItem value="Desktop" label="Windows & Linux" />
    <StatItem value="TV/VR" label="Smart TVs & Headsets" />
  </div>
</div>

<!-- ==============================================================
     TECHNICAL SPECIFICATIONS
============================================================== -->
<section id="technical-specifications" class="-mb-12">
  <div class="flex flex-col border-y border-subtle divide-y divide-subtle max-w-5xl mx-auto">
    {technicalSpecs.map((spec) => (
      <Marquee
        items={spec.items}
        reverse={spec.reverse}
        speed={spec.speed}
        bordered={false}
        separator="✦"
      />
    ))}
  </div>
</section>

<WaitlistModal />

<Footer />

<style>
  .features-runway {
    position: relative;
    width: 100%;
  }

  .features-pin-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .features-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 768px) {
    .features-pin-wrap {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    .features-track {
      display: flex;
      align-items: center;
      padding-left: max(6vw, 32px);
      padding-right: max(12vw, 64px);
      will-change: transform;
    }
  }

  @media (max-width: 767px) {
    .features-runway {
      height: auto !important;
      padding: 4rem 0 3rem;
    }

    .features-pin-wrap {
      position: relative !important;
      height: auto !important;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding: 0 1.25rem 1.5rem;
    }

    .features-track {
      display: flex;
      align-items: stretch;
      gap: 1.25rem;
      width: max-content;
      transform: none !important;
    }

    .features-track > div {
      scroll-snap-align: start;
    }

    .features-bg {
      position: sticky;
      left: 0;
      width: 100vw;
      min-width: 100vw;
      margin-left: -1.25rem;
      margin-right: -1.25rem;
      height: 100%;
    }
  }

  @keyframes scrollLine {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  .scroll-line-runner {
    animation: scrollLine 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
</style>

<script is:inline>
  // Horizontal Scroll for Features Section (inspired by openmontage.video track)
  (function () {
    const runway = document.getElementById('features');
    const pinWrap = document.querySelector('[data-ref="pinWrap"]');
    const track = document.querySelector('[data-ref="track"]');
    if (!runway || !pinWrap || !track) return;

    let totalDistance = 0;
    let isDesktop = false;

    function calcDimensions() {
      isDesktop = window.innerWidth >= 768;
      if (!isDesktop) {
        runway.style.height = 'auto';
        track.style.transform = 'none';
        return;
      }

      // Reset transform temporarily to measure natural scrollWidth
      track.style.transform = 'none';
      const trackWidth = track.scrollWidth;
      const viewportWidth = window.innerWidth;

      // Distance the track needs to slide to reveal all cards with comfortable ending margin
      totalDistance = Math.max(0, trackWidth - viewportWidth + 60);

      // Runway height is the viewport height PLUS the horizontal distance needed
      runway.style.height = `${window.innerHeight + totalDistance}px`;
      updateScroll();
    }

    function updateScroll() {
      if (!isDesktop || totalDistance <= 0) return;
      const rect = runway.getBoundingClientRect();
      const scrolled = -rect.top;
      const clamped = Math.max(0, Math.min(totalDistance, scrolled));
      track.style.transform = `translate3d(${-clamped}px, 0, 0)`;
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateScroll();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', calcDimensions, { passive: true });

    // Initial setup on DOM ready, window load, and font settlement
    calcDimensions();
    window.addEventListener('load', calcDimensions);
    setTimeout(calcDimensions, 300);
    setTimeout(calcDimensions, 1000);
  })();
</script>
