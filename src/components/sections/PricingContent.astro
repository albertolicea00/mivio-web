  </section> -->

  <!-- Pricing FAQs -->
  <section class="mb-20">
    <div class="text-center mb-10">
      <h2 class="font-extrabold text-2xl sm:text-3xl text-fg mb-2">Frequently asked questions</h2>
      <p class="text-fg-subtle">Everything you need to know about Mivio plans and billing.</p>
    </div>
    <div class="max-w-3xl mx-auto flex flex-col gap-4">
      <FAQItem question="Can I upgrade, downgrade, or cancel at any time?">
        Yes, you can upgrade, downgrade, or cancel your subscription whenever you want from your account dashboard. If you cancel, you will maintain access until the end of your current billing period.
      </FAQItem>
      <FAQItem question="How does the introductory price work?">
        Your first month is discounted so you can test Mivio Cloud risk-free. After the first 30 days, your subscription renews at the regular monthly or annual rate unless changed.
      </FAQItem>
      <FAQItem question="What devices can I use Mivio on?">
        Mivio is fully multi-platform. With a single account you can stream your media on iOS, iPadOS, Android, Apple TV, Android TV, macOS, Windows, Linux, and Meta Quest (VR).
      </FAQItem>
      <FAQItem question="Is my personal media private and secure?">
        Absolutely. Your media files are completely private. We never scan, analyze, or train models on your personal content, and all transfers are encrypted end-to-end.
      </FAQItem>
      <FAQItem question="Do you support custom business or enterprise setups?">
        Yes! We offer dedicated enterprise deployment, white-label solutions, and custom volume pricing. Check our <a href="b2b.html" class="text-primary hover:underline font-semibold">B2B page</a> or contact us directly.
      </FAQItem>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="card rounded-3xl p-10 text-center">
    <h2 class="font-bold text-2xl text-fg mb-2">Not sure which plan fits?</h2>
    <p class="text-fg-subtle mb-6 max-w-xl mx-auto">
      Ask us anything — which tier is right for you, how referrals work, or how to migrate your existing library at zero cost.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="mailto:cloud@mivio.app?subject=Mivio%20Pricing%20Question" class="btn-primary text-white font-bold px-8 py-3.5 rounded-2xl text-sm">
        Get in touch
      </a>
      <a href="b2b.html" class="btn-outline font-semibold px-8 py-3.5 rounded-2xl text-sm hover:border-primary/50 transition-colors">
        Explore B2B Solutions
      </a>
    </div>
  </section>
</main>

<WaitlistModal />
<Footer />

<script is:inline>
  // Billing toggle
  (function () {
    const monthlyBtn = document.getElementById('billing-monthly-btn');
    const annualBtn = document.getElementById('billing-annual-btn');
    const monthlyElements = document.querySelectorAll('.billing-monthly');
    const annualElements = document.querySelectorAll('.billing-annual');

    function setBilling(isAnnual) {
      monthlyBtn?.setAttribute('aria-pressed', String(!isAnnual));
      annualBtn?.setAttribute('aria-pressed', String(isAnnual));

      if (isAnnual) {
        monthlyBtn?.classList.remove('bg-fg', 'text-page', 'font-bold', 'shadow');
        monthlyBtn?.classList.add('text-fg-subtle', 'hover:text-fg');
        annualBtn?.classList.remove('text-fg-subtle', 'hover:text-fg');
        annualBtn?.classList.add('bg-fg', 'text-page', 'font-bold', 'shadow');

        monthlyElements.forEach((el) => el.classList.add('hidden'));
        annualElements.forEach((el) => el.classList.remove('hidden'));
      } else {
        annualBtn?.classList.remove('bg-fg', 'text-page', 'font-bold', 'shadow');
        annualBtn?.classList.add('text-fg-subtle', 'hover:text-fg');
        monthlyBtn?.classList.remove('text-fg-subtle', 'hover:text-fg');
        monthlyBtn?.classList.add('bg-fg', 'text-page', 'font-bold', 'shadow');

        annualElements.forEach((el) => el.classList.add('hidden'));
        monthlyElements.forEach((el) => el.classList.remove('hidden'));
      }
    }

    monthlyBtn?.addEventListener('click', () => setBilling(false));
    annualBtn?.addEventListener('click', () => setBilling(true));
  })();

  // Custom Plan calculator
  (function () {
    const slider = document.getElementById('pricing-storage-slider');
    const label = document.getElementById('pricing-storage-slider-label');
    const message = document.getElementById('pricing-custom-plan-message');
    const sendBtn = document.getElementById('pricing-custom-plan-send-btn');
    if (!slider || !label || !sendBtn) return;

    const storageOptions = ['3 TB', '4 TB', '5 TB', '10 TB', '15 TB', '20 TB', '25 TB', 'Custom'];

    function updateMailto() {
      const idx = Number(slider.value) || 0;
      const storageLabel = storageOptions[idx] || 'Custom';
      label.textContent = storageLabel;
      slider.setAttribute('aria-valuetext', storageLabel);

      const text = message?.value || '';
      const body = `Storage: ${storageLabel}\n\n${text}`;
      sendBtn.setAttribute(
        'href',
        `mailto:cloud@mivio.app?subject=${encodeURIComponent('Mivio Cloud Custom Plan')}&body=${encodeURIComponent(body)}`
      );
    }

    slider.addEventListener('input', updateMailto);
    message?.addEventListener('input', updateMailto);
    updateMailto();
  })();

  // FAQ Accordion
  (function () {
    document.querySelectorAll('.faq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const item = btn.closest('.faq-item');
        const content = item?.querySelector('.faq-content');
        const icon = item?.querySelector('.faq-icon');

        btn.setAttribute('aria-expanded', String(!isExpanded));
        if (content) {
          content.classList.toggle('hidden', isExpanded);
        }
        if (icon) {
          icon.classList.toggle('rotate-180', !isExpanded);
        }
      });
    });
  })();
</script>
