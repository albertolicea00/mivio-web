---
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import WaitlistModal from '../WaitlistModal.astro';
import PricingCard from '../ui/PricingCard.astro';
import FAQItem from '../ui/FAQItem.astro';
---

<Navbar />

<main id="main-content" class="pt-32 pb-24 px-6 max-w-6xl mx-auto">
  <!-- Hero -->
  <header class="text-center mb-16">

    <h1 class="font-extrabold text-4xl sm:text-5xl md:text-6xl mb-6 text-fg leading-tight">
      Simple, transparent<br /><span class="gradient-text">pricing for everyone.</span>
    </h1>

    <p class="text-fg-subtle text-lg max-w-2xl mx-auto leading-relaxed mb-10">
      Choose the tier that fits your personal library or business. Start almost free, cancel anytime. No hidden fees or lock-ins.
    </p>

    <!-- Billing toggle -->
    <div class="inline-flex items-center gap-1 bg-surface-alt border border-subtle rounded-full px-1.5 py-1.5">
      <button
        type="button"
        id="billing-monthly-btn"
        aria-pressed="true"
        class="px-4 py-1.5 rounded-full text-sm transition-all duration-200 whitespace-nowrap bg-fg text-page font-bold shadow"
      >
        Monthly
      </button>
      <button
        type="button"
        id="billing-annual-btn"
        aria-pressed="false"
        class="px-4 py-1.5 rounded-full text-sm transition-all duration-200 flex items-center gap-1.5 whitespace-nowrap text-fg-subtle hover:text-fg"
      >
        Annual
        <span class="text-xs font-semibold text-primary bg-primary/10 px-2 py-0.5 rounded-full">-17%</span>
      </button>
    </div>
  </header>

  <!-- 4 plan cards -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-16">
    <PricingCard
      plan="Lite"
      monthlyFirst="$0.99"
      monthlyThen="$2.36/mo"
      annualPrice="$2.06"
      annualBilled="$24.70/year"
      features={[
        '100 GB storage',
        '300 GB/mo bandwidth',
        'All Mivio apps included',
        'Mobile & desktop access',
        'yourname.mivio.cloud subdomain',
        'Basic file streaming',
        'Automatic backups',
      ]}
      waitlistSegment="Mivio Cloud"
    />
    <PricingCard
      plan="Standard"
      popular={true}
      monthlyFirst="$3.36"
      monthlyThen="$7.73/mo"
      annualPrice="$6.13"
      annualBilled="$73.60/year"
      featuresIntro="Everything in Lite ... &"
      features={[
        '500 GB storage',
        '1.5 TB/mo bandwidth',
        'Smart TV & VR access',
        'Video streaming',
        'Web file manager',
        'Custom domain mapping',
      ]}
      waitlistSegment="Mivio Cloud"
    />
    <PricingCard
      plan="Premium"
      monthlyFirst="$5.47"
      monthlyThen="$12.89/mo"
      annualPrice="$10.74"
      annualBilled="$128.90/year"
      featuresIntro="Everything in Standard ... &"
      features={[
        '1 TB storage',
        '3 TB/mo bandwidth',
        'HD streaming',
        'Music support',
        'Subtitle & metadata auto-fetch',
        'Email support',
      ]}
      waitlistSegment="Mivio Cloud"
    />
    <PricingCard
      plan="Ultra"
      monthlyFirst="$8.99"
      monthlyThen="$19.73/mo"
      annualPrice="$16.44"
      annualBilled="$197.30/year"
      featuresIntro="Everything in Premium ... &"
      features={[
        '2 TB storage',
        'Unlimited bandwidth',
        '4K streaming',
        'Multi-user (family)',
        'Priority support',
        'Own domain support',
      ]}
      waitlistSegment="Mivio Cloud"
    />
  </section>

  <!-- Custom Plan: Let's talk -->
  <section class="card rounded-3xl p-8 border-primary/20 hover:border-primary/35 transition-colors mb-20">
    <div class="flex flex-col md:flex-row gap-10 items-start">
      <div class="md:w-64 shrink-0">
        <span class="text-xs font-semibold uppercase tracking-widest text-fg-faint">Custom</span>
        <h2 class="font-extrabold text-2xl text-fg mt-1 mb-3">Let's talk</h2>
        <p class="text-fg-subtle text-sm leading-relaxed mb-4">
          Need more than 2 TB, a dedicated server, or tailored team deployment? Tell us what you need.
        </p>
        <ul class="flex flex-col gap-2 text-sm text-fg-subtle">
          <li class="flex items-center gap-2">
            <svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Flexible storage
          </li>
          <li class="flex items-center gap-2">
            <svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Dedicated server
          </li>
          <li class="flex items-center gap-2">
            <svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Direct personal support
          </li>
        </ul>
      </div>

      <div class="flex-1 flex flex-col gap-5 w-full">
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <label for="pricing-storage-slider" class="text-xs font-semibold text-fg-subtle uppercase tracking-wide">Storage needed</label>
            <span id="pricing-storage-slider-label" class="text-sm font-bold text-primary" aria-live="polite">5 TB</span>
          </div>
          <input
            id="pricing-storage-slider"
            type="range"
            min="0"
            max="7"
            value="2"
            step="1"
            aria-valuetext="5 TB"
            class="w-full h-2 rounded-full appearance-none cursor-pointer accent-primary bg-surface-alt border border-subtle"
          />
          <div class="flex justify-between text-xs text-fg-faint">
            <span>3000 GB</span>
            <span>30 TB+</span>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="pricing-custom-plan-message" class="text-xs font-semibold text-fg-subtle uppercase tracking-wide">Tell us more (optional)</label>
          <textarea
            id="pricing-custom-plan-message"
            rows="3"
            placeholder="Describe what you need — media types, use case, team size, anything relevant…"
            class="w-full rounded-xl border border-subtle bg-surface px-4 py-2.5 text-sm text-fg placeholder:text-fg-faint focus:outline-none focus:border-primary/50 transition-colors resize-none"
          ></textarea>
        </div>

        <a
          id="pricing-custom-plan-send-btn"
          href="mailto:cloud@mivio.app?subject=Mivio%20Cloud%20Custom%20Plan&body=Storage%3A%205%20TB%0A%0A"
          class="btn-primary text-white font-bold px-5 py-3 rounded-2xl text-sm text-center inline-flex items-center justify-center gap-2 self-start"
        >
          <svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Send request
        </a>
      </div>
    </div>
  </section>

  <!-- More ways to save -->
