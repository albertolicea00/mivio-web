---
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import WaitlistModal from '../WaitlistModal.astro';
import PricingCard from '../ui/PricingCard.astro';
import FAQItem from '../ui/FAQItem.astro';

const richFeatures = [
  {
    title: 'Additional video formats',
    description: 'Enjoy even more video formats and save yourself from hours and hours of file conversions.',
    icon: 'format',
  },
  {
    title: 'Lossless HD audio',
    description: 'Experience studio-quality sound with support for lossless 24-bit HD audio in stunning detail.',
    icon: 'audio',
  },
  {
    title: 'AirPlay & Google Cast',
    description: 'Stream videos to the big screen with surround sound and subtitles via AirPlay and Google Cast.',
    icon: 'cast',
  },
  {
    title: 'Dolby Vision and Atmos',
    description: 'Enjoy videos in all their high-fidelity glory with Dolby Vision (Profile 5 & 8) and Dolby Atmos (E-AC3).',
    icon: 'dolby',
  },
  {
    title: 'Trailers',
    description: 'Stream high-quality video trailers for movies and TV shows seamlessly from within the app.',
    icon: 'trailers',
  },
  {
    title: 'Advanced library sync',
    description: 'Keep libraries, playback progress, and watched history in sync with other devices using iCloud.',
    icon: 'sync',
  },
  {
    title: 'Cloud streaming',
    description: 'Connect to Dropbox, Google Drive, OneDrive, Box, pCloud, Yandex.Disk, MEGA, Aliyun Drive, and more.',
    icon: 'cloud',
  },
  {
    title: 'Updates for life',
    description: 'Get access to all future updates — even major releases like v9, v10, and beyond — with a subscription',
    icon: 'updates',
  },
];
---

<Navbar />

<main id="main-content" class="pt-32 pb-24 px-6 max-w-6xl mx-auto">
  <!-- Hero Header -->
  <header class="text-center mb-16">
    <h1 class="font-extrabold text-4xl sm:text-5xl md:text-6xl mb-6 text-fg leading-tight">
      Simple, transparent<br /><span class="gradient-text">pricing for everyone.</span>
    </h1>

    <p class="text-fg-subtle text-base sm:text-lg max-w-2xl mx-auto leading-relaxed mb-6">
      Unlock the full power of Mivio on all your devices. Every single plan includes every Pro feature with zero compromises.
    </p>

    <!-- Trial highlight pill -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface-alt border border-subtle text-xs sm:text-sm text-fg-subtle">
      <svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><strong class="text-fg">Free 7-day trial</strong> on Yearly plan · Cancel anytime</span>
    </div>
  </header>

  <!-- 3 Pricing Cards Grid -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20 max-w-5xl mx-auto items-stretch">
    <!-- Monthly Plan -->
    <PricingCard
      plan="Monthly"
      price="$1.99"
      period="/ month"
      billedNote="Billed monthly · Cancel anytime"
      ctaText="Subscribe Monthly"
      popular={false}
      waitlistSegment="Mivio Pro Monthly"
    />

    <!-- Yearly Plan (Highlighted) -->
    <PricingCard
      plan="Yearly"
      price="$16.99"
      period="/ year"
      savingsBadge="Best Value · Save 29%"
      billedNote="Just $1.41 / mo · Billed annually"
      ctaText="Start 7-Day Free Trial"
      popular={true}
      waitlistSegment="Mivio Pro Yearly (Free Trial)"
    />

    <!-- Lifetime Plan -->
    <PricingCard
      plan="Lifetime"
      price="$99.99"
      period="/ lifetime"
      savingsBadge="One-Time Purchase"
      billedNote="Pay once, own forever · No subscriptions"
      ctaText="Get Lifetime Access"
      popular={false}
      waitlistSegment="Mivio Pro Lifetime"
    />
  </section>

  <!-- Feature Grid Breakdown: "las cosas que incluye debajo tipo features" -->
  <section class="mb-24 pt-12 border-t border-subtle">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-widest text-primary mb-2 block">Always Included</span>
      <h2 class="font-extrabold text-3xl sm:text-4xl text-fg mb-4">
        Features included in every plan
      </h2>
      <p class="text-fg-subtle text-base leading-relaxed">
        Everything you need for an uncompromised media playback experience. Whether you subscribe monthly, yearly, or choose lifetime, you get 100% of these capabilities:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-5xl mx-auto">
      {richFeatures.map((feature) => (
        <div class="card rounded-3xl p-6 sm:p-7 flex flex-col gap-2 hover:border-primary/30 transition-all duration-300">
          <div class="flex items-center gap-2.5">
            {feature.icon === 'format' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
              </svg>
            )}
            {feature.icon === 'audio' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
            )}
            {feature.icon === 'cast' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            )}
            {feature.icon === 'dolby' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            )}
            {feature.icon === 'trailers' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {feature.icon === 'sync' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            )}
            {feature.icon === 'cloud' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            )}
            {feature.icon === 'updates' && (
              <svg aria-hidden="true" class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            <h3 class="text-base sm:text-lg font-bold text-fg">{feature.title}</h3>
          </div>

          <p class="text-fg-subtle text-sm leading-relaxed">{feature.description}</p>
          {feature.note && (
            <div class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-primary">
              <svg aria-hidden="true" class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{feature.note}</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing FAQs -->
  <section class="mb-20">
    <div class="text-center mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-primary mb-2 block">FAQ</span>
      <h2 class="font-extrabold text-2xl sm:text-3xl text-fg mb-2">Frequently asked questions</h2>
      <p class="text-fg-subtle">Everything you need to know about Mivio Pro plans and billing.</p>
    </div>
    <div class="max-w-3xl mx-auto flex flex-col gap-4">
      <FAQItem question="How does the free 7-day trial work?">
        The free 7-day trial is included when you choose the Yearly plan ($16.99/year). You get full access to all Pro features with zero limitations. You can cancel at any time within the 7 days directly from your device settings without being charged.
      </FAQItem>
      <FAQItem question="What is included with the Lifetime purchase?">
        The Lifetime plan is a single one-time payment of $99.99 with no ongoing subscriptions or renewal fees. It includes all current Pro features as well as access to all future updates — including major releases like v9, v10, and beyond.
      </FAQItem>
      <FAQItem question="Are all features really the same across every plan?">
        Yes! All three plans ($1.99/mo, $16.99/yr, $99.99/lifetime) include the exact same comprehensive set of Pro features: additional video formats, lossless HD audio, AirPlay & Google Cast, Dolby Vision & Atmos, movie trailers, iCloud sync, and cloud streaming.
      </FAQItem>
      <FAQItem question="What cloud storage providers can I stream from?">
        Mivio connects directly to Dropbox, Google Drive, Microsoft OneDrive, Box, pCloud, Yandex.Disk, MEGA, Aliyun Drive, WebDAV, SMB, and local network shares without requiring any separate server software.
      </FAQItem>
      <FAQItem question="Can I upgrade, downgrade, or cancel at any time?">
        Yes, you can manage or cancel your subscription at any time. If you cancel a recurring subscription, you will maintain complete Pro access until the end of your paid billing period.
      </FAQItem>
    </div>
  </section>

</main>

<WaitlistModal />
<Footer />

<script is:inline>
  // FAQ Accordion
  (function () {
    document.querySelectorAll('.faq-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const item = btn.closest('.faq-item');
        const content = item?.querySelector('.faq-content');
        const icon = item?.querySelector('.faq-icon');

        btn.setAttribute('aria-expanded', String(!isExpanded));
        if (content) {
          content.classList.toggle('hidden', isExpanded);
        }
        if (icon) {
          icon.classList.toggle('rotate-180', !isExpanded);
        }
      });
    });
  })();
</script>
