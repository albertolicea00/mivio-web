---
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import WaitlistModal from '../WaitlistModal.astro';
---

<Navbar />

<main id="main-content" class="min-h-screen flex flex-col items-center justify-center text-center px-6 pt-24 pb-24">

  <h1 class="font-extrabold text-4xl sm:text-5xl mb-4 text-fg leading-tight">
    Mivio <span class="gradient-text">Marketplace</span>
  </h1>

  <p class="text-fg-subtle text-lg max-w-xl mx-auto mb-8 leading-relaxed">
    A curated library of 3D virtual environments for your spatial media room. Browse and install immersive spaces created by independent designers — cinemas, home theaters, space stations, cozy cabins, and more. Available on Meta Quest, Apple Vision Pro, Pico, HTC Vive, and more.
  </p>

  <div class="flex flex-col gap-8 max-w-lg mx-auto mb-12 text-center">
    <div class="flex flex-col gap-1.5">
      <h2 class="text-fg font-bold text-lg">For creators</h2>
      <p class="text-fg-subtle text-sm leading-relaxed">Submit your 3D environments and earn from every install.</p>
    </div>
    <div class="flex flex-col gap-1.5">
      <h2 class="text-fg font-bold text-lg">For users</h2>
      <p class="text-fg-subtle text-sm leading-relaxed">Personalize your VR media experience with unique spaces.</p>
    </div>
  </div>

  <p class="text-fg-faint text-sm mb-6">Want to be notified when we launch?</p>
  <button type="button" data-waitlist="Mivio Marketplace"
    class="btn-primary text-white font-bold px-8 py-3 rounded-2xl text-sm">
    Join the waitlist
  </button>

</main>

<WaitlistModal />
<Footer />
