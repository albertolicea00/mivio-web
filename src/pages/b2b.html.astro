---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WaitlistModal from '../components/WaitlistModal.astro';

const title = 'Mivio B2B — Enterprise & White-Label Licensing';
const description = 'Mivio B2B — White-label licensing and enterprise deployments. Ship Mivio under your own brand.';
---
<Layout title={title} description={description} path="/b2b.html">


  <Navbar />

  <main id="main-content" class="pt-32 pb-24 px-6 max-w-5xl mx-auto">

    <!-- Hero -->
    <header class="text-center mb-20">
      <h1 class="font-extrabold text-4xl sm:text-5xl md:text-6xl mb-6 text-fg leading-tight">
        Mivio for<br/><span class="gradient-text">your business.</span>
      </h1>
      <p class="text-fg-subtle text-lg max-w-2xl mx-auto leading-relaxed">
        Deploy Mivio at scale across your organization, or ship it under your own brand. Custom licensing agreements for hotels, universities, academies, media companies, and any organization that needs a professional media experience.
      </p>
    </header>

    <!-- Two models -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">

      <!-- Enterprise deployment -->
      <div class="card rounded-3xl p-8 flex flex-col gap-5">
        <div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
          <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <div>
          <h2 class="font-bold text-xl text-fg mb-2">Enterprise Deployment</h2>
          <p class="text-fg-subtle text-sm leading-relaxed">Roll out Mivio across your entire organization. Manage users, control access, and provide a unified media experience — all under your IT infrastructure.</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-fg-subtle">
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Centralized user management</li>
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> On-premise or cloud-hosted</li>
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> All platforms included</li>
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Dedicated support channel</li>
        </ul>
        <p class="text-fg-faint text-xs">Ideal for: hotels, hospitals, universities, academies, corporate campuses.</p>
      </div>

      <!-- White-label -->
      <div class="card rounded-3xl p-8 flex flex-col gap-5 border-primary/30">
        <div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
          <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
        </div>
        <div>
          <h2 class="font-bold text-xl text-fg mb-2">White-Label Licensing</h2>
          <p class="text-fg-subtle text-sm leading-relaxed">Ship Mivio under your own brand, with your logo, your colors, and your app store presence. Full commercial rights with a custom licensing agreement.</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-fg-subtle">
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Custom branding &amp; identity</li>
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Commercial redistribution rights</li>
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Source access (negotiated)</li>
          <li class="flex items-start gap-2"><svg aria-hidden="true" class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Co-development available</li>
        </ul>
        <p class="text-fg-faint text-xs">Ideal for: media companies, telecom operators, set-top box manufacturers, streaming platforms.</p>
      </div>

    </section>

    <!-- Pricing model -->
    <section class="card rounded-3xl p-8 mb-20">
      <h2 class="font-bold text-xl text-fg mb-4">Pricing Model</h2>
      <p class="text-fg-subtle text-sm mb-6 leading-relaxed">B2B licensing is not a fixed price list — it's a conversation. Every organization has different scale, requirements, and goals. Pricing is negotiated based on the scope of the agreement.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-sm">
        <div class="flex flex-col gap-1">
          <span class="font-semibold text-fg">Per-seat license</span>
          <span class="text-fg-subtle">For enterprise deployments with a defined user base.</span>
        </div>
        <div class="flex flex-col gap-1">
          <span class="font-semibold text-fg">Revenue share</span>
          <span class="text-fg-subtle">For white-label products that generate commercial revenue.</span>
        </div>
        <div class="flex flex-col gap-1">
          <span class="font-semibold text-fg">One-time license</span>
          <span class="text-fg-subtle">For specific deployments or internal-use tools without recurring billing.</span>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center">
      <h2 class="font-bold text-2xl text-fg mb-3">Ready to talk?</h2>
      <p class="text-fg-subtle mb-6 max-w-xl mx-auto">Tell us about your project and we'll get back to you with a proposal tailored to your needs.</p>
      <!-- Contact button — uncomment when live
      <a href="mailto:b2b@mivio.app?subject=Mivio B2B Inquiry"
        class="btn-primary text-white font-bold px-8 py-4 rounded-2xl text-base inline-block">Contact us →</a>
      -->
      <button
        type="button" @click="$store.waitlist.show('Mivio B2B')"
        class="btn-primary text-white font-bold px-8 py-4 rounded-2xl text-base">
        Get early access
      </button>
    </section>

  </main>

  <!-- Waitlist modal -->
  <WaitlistModal />

  <Footer />


</Layout>
