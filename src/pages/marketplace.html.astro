---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WaitlistModal from '../components/WaitlistModal.astro';

const title = 'Mivio Marketplace — Coming Soon';
const description = 'Mivio Marketplace — A curated library of 3D virtual environments for your VR media room. Coming soon.';
---
<Layout title={title} description={description} path="/marketplace.html">


  <Navbar />

  <main id="main-content" class="min-h-screen flex flex-col items-center justify-center text-center px-6 pt-24 pb-24">

    <!-- Badge -->
    <div class="hero-badge inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs mb-8">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span>Coming Soon</span>
    </div>

    <!-- Icon -->
    <div class="w-20 h-20 rounded-3xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary mb-8">
      <svg aria-hidden="true" class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M9.75 3.5h4.5M3 8.5h18M3 8.5a2 2 0 00-2 2v3a2 2 0 002 2h3.5l1.25 1.75a1.5 1.5 0 002.5 0L11.5 15.5h1l.25.75a1.5 1.5 0 002.5 0L16.5 15.5H20a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/>
      </svg>
    </div>

    <h1 class="font-extrabold text-4xl sm:text-5xl mb-4 text-fg leading-tight">
      Mivio <span class="gradient-text">Marketplace</span>
    </h1>

    <p class="text-fg-subtle text-lg max-w-xl mx-auto mb-8 leading-relaxed">
      A curated library of 3D virtual environments for your spatial media room. Browse and install immersive spaces created by independent designers — cinemas, home theaters, space stations, cozy cabins, and more. Available on Meta Quest, Apple Vision Pro, Pico, HTC Vive, and more.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <div class="card rounded-2xl px-6 py-4 flex flex-col gap-1 text-left">
        <span class="text-fg font-semibold text-sm">For creators</span>
        <span class="text-fg-faint text-xs">Submit your 3D environments and earn from every install.</span>
      </div>
      <div class="card rounded-2xl px-6 py-4 flex flex-col gap-1 text-left">
        <span class="text-fg font-semibold text-sm">For users</span>
        <span class="text-fg-faint text-xs">Personalize your VR media experience with unique spaces.</span>
      </div>
    </div>

    <p class="text-fg-faint text-sm mb-6">Want to be notified when we launch?</p>
    <button type="button" @click="$store.waitlist.show('Mivio Marketplace')"
      class="btn-primary text-white font-bold px-8 py-3 rounded-2xl text-sm">
      Join the waitlist
    </button>

  </main>

  <!-- Waitlist modal -->
  <WaitlistModal />

  <Footer />


</Layout>
