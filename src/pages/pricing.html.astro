---
import Layout from '../layouts/Layout.astro';
import PricingContent from '../components/sections/PricingContent.astro';

const title = 'Mivio Pro Pricing — $1.99/mo, $16.99/yr, $99.99/lifetime';
const description = 'Unlock the full power of Mivio with Mivio Pro. Monthly ($1.99), Yearly ($16.99 with free 7-day trial), or Lifetime ($99.99). All pro features included.';
---
<Layout title={title} description={description} path="/pricing.html">
  <PricingContent />
</Layout>
