---
export interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const ogUrl = new URL(path, Astro.site).toString();
const ogImage = new URL('/static/images/og-image.png', Astro.site).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <title>{title}</title>
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#FF6B00" />

  <link rel="icon" type="image/png" href="/static/images/favicon.png" />
  <link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- App styles -->
  <link rel="stylesheet" href="/static/css/style.css" />

  <!-- Alpine.js — must load BEFORE app.js so stores register on alpine:init -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script is:inline src="/static/js/app.js"></script>
  <script is:inline defer src="/static/js/os-detector.js"></script>
</head>

<!-- Root: initialise theme from localStorage on first paint -->
<body class="font-sans antialiased bg-page text-fg" x-data x-init="$store.theme.init()">
  <slot />

</body>

</html>
